---
import '@common/Global.css';
import { ClientRouter } from 'astro:transitions';
const { title = "sn2025" } = Astro.props;
---
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<ClientRouter />
		<link rel="icon" id="dynamic-favicon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<!-- <meta name="generator" content={Astro.generator} />  -->
		<meta name="color-scheme" content="light dark">
		<link rel="apple-touch-icon" href="/favicon.svg">
		<title>{title}</title>
		<!-- 네이버 서치어드바이저-->
		<meta name="naver-site-verification" content="5c92cd8d54ffd6a986ff0b33eb3cc9bf2daf9b16" />
		<!-- 구글 서치 콘솔 -->
		<meta name="google-site-verification" content="RO86cN92O843BZaZbAr4PQzvWqOfFP3R2jvQLLxTXTumY">

		<meta name="description" content="새로운 형태의 경험 shape new, 순(s&#8203;n)">
        <meta name="author" content="최이수, 순 (s&#8203;n)">
        <meta name="keywords" content="최이수, 순, sn, s n, 순sn, sn순, 순 sn, 스튜디오순, 순스튜디오, 디자인순, 순디자인, 에이전시순, 순에이전시, sn design, sn studio, studio sn, brand agency sn, contact@sn-studio.kr, sn-studio, sn문의, sn이메일, 브랜드디자인, 브랜드아이덴티티, BI, BX, BI BX, 브랜딩, 브랜드전략, 브랜드컨설팅, 로고디자인, 심볼디자인, 비주얼아이덴티티, 비주얼시스템, 그래픽디자인, 시각디자인, 디자인스튜디오, 디자인에이전시, 크리에이티브스튜디오, 웹디자인, 웹에이전시, 커스텀웹, 반응형웹, 인터랙티브웹, 포트폴리오웹, 타이포그래피, 서체디자인, 폰트디자인, 아트디렉션">
        <meta name="robots" content="index, follow">

        <meta property="og:type" content="website">
        <meta property="og:site_name" content="순 (s&#8203;n)">
        <meta property="og:title" content={title}>
        <meta property="og:description" content="새로운 형태의 경험 shape new, 순(s&#8203;n)">
        <meta property="og:image" content="/favicon.svg">

        <meta name="twitter:card" content="summary">
        <meta name="twitter:title" content={title}>
        <meta name="twitter:description" content="새로운 형태의 경험 shape new, 순(s&#8203;n)">
        <meta name="twitter:image" content="/favicon.svg">

		<link rel="preload" href="/fonts/GeistMono.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="preload" href="/fonts/AstaSans.woff2" as="font" type="font/woff2" crossorigin>

		<script is:inline src="/favicon.js"></script>
	</head>
	<body>
		<main>
			<!-- 각 페이지의 내용이 이 자리에 쏙 들어옵니다 -->
			<slot />
		</main>
		<script>import '@common/Global.js';</script>
    </body>
</html>