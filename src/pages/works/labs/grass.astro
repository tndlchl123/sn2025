---
import Layout from '@common/Design-Layout.astro';
---

<Layout title="grass">
    <div class="modal-inner-data">
        <div class="canvas-wrap">
            <canvas id="artCanvas"></canvas>
        </div>
    </div>
</Layout>


<style is:global>
    .works-modal-box {
        border-radius: var(--rad);
    }
    .canvas-wrap {
        width: 50vw;
        aspect-ratio: 3 / 4;
        position: relative;
        background-color: #394522; /* 캔버스 배경 */
        overflow: hidden;

        /* rgba(var(--dynamic-point-r), 1) */
        --canvas-line-color: #84944e; /* 메인 선 */
        --canvas-outline-color: rgba(0, 0, 0, 0.8); /* 테두리 */
    }

    canvas {
        width: 100%;
        height: 100%;
        display: block;
    }
</style>

<script is:inline>
    (function() {
        const canvas = document.getElementById('artCanvas');
        const wrap = document.querySelector('.canvas-wrap'); 
        

        const ctx = canvas.getContext('2d');

        // 🎨 CSS에 적어둔 변수 값을 JS가 실시간으로 가져옵니다!
        const wrapStyle = getComputedStyle(wrap);
        const LINE_COLOR = wrapStyle.getPropertyValue('--canvas-line-color').trim() || '#111111';
        const OUTLINE_COLOR = wrapStyle.getPropertyValue('--canvas-outline-color').trim() || '#ffffff';

        let lines = [];
        let time = 0;
        
        // ==========================================
        // ⚙️ 2. 여기서 그래픽 느낌을 마음대로 조절하세요!
        // ==========================================
        const lineCount = 5000;      // 👈 [밀도 조절] 선의 개수. (기존 800 -> 3000으로 늘려서 아주 빽빽해짐!)
        const windSpeed = 0.02;      // 👈 [속도 조절] 숫자가 커지면 바람이 빨리 붑니다 (예: 0.03)
        const windScale = 0.004;     // 👈 [구불거림 조절] 숫자가 커지면 선들이 더 꼬불꼬불해집니다 (예: 0.01)
        // ==========================================

        let animationId;

        function initLines(width, height) {
            lines = [];
            for (let i = 0; i < lineCount; i++) {
                lines.push({
                    x: Math.random() * width,        
                    y: Math.random() * height,       
                    // 👈 [길이 조절] 숫자를 늘리면 개별 선이 길어집니다
                    length: Math.random() * 100 + 50, 
                    // 👈 [두께 조절] 선의 두께 범위 (현재 2~6)
                    thickness: Math.random() * 2 + 1  
                });
            }
        }

        const resizeObserver = new ResizeObserver(entries => {
            const rect = entries[0].contentRect;
            if (rect.width === 0 || rect.height === 0) return;

            const dpr = window.devicePixelRatio || 1; 
            const newWidth = rect.width * dpr;
            const newHeight = rect.height * dpr;

            if (canvas.width !== newWidth || canvas.height !== newHeight) {
                canvas.width = newWidth;
                canvas.height = newHeight;
                ctx.scale(dpr, dpr);
                
                initLines(rect.width, rect.height);
                
                if (!animationId) {
                    draw();
                }
            }
        });

        resizeObserver.observe(wrap);

        function draw() {
            if (!document.getElementById('artCanvas')) return; 

            const width = canvas.width;
            const height = canvas.height;

            // 매 프레임마다 이전 화면을 지워줌 (이걸 안 지우면 선이 잔상처럼 꽉 차버림)
            ctx.clearRect(0, 0, width, height);
            
            // 💡 선의 끝부분을 둥글게(round) 할지 네모나게(square) 할지 결정 (JS 문법이라 여기에 남겨둠)
            ctx.lineCap = 'round'; 
            ctx.lineJoin = 'round'; 

            lines.forEach(line => {
                let lx = line.x;
                let ly = line.y;

                // 1. 하얀색(배경색) 테두리를 먼저 그려서 선들끼리 겹칠 때 입체감을 줌
                ctx.lineWidth = line.thickness + 1; 
                ctx.strokeStyle = OUTLINE_COLOR; // 👈 CSS에서 가져온 변수 적용!
                ctx.beginPath();
                ctx.moveTo(lx, ly);

                let vertices = []; 
                for (let step = 0; step < line.length; step += 5) {
                    let angle = Math.sin(lx * windScale + time) * 1.2 + 
                                Math.cos(ly * windScale + time * 0.8) * 1.2 - 
                                Math.PI / 4;
                    lx += Math.cos(angle) * 5;
                    ly += Math.sin(angle) * 5;
                    ctx.lineTo(lx, ly);
                    vertices.push({ x: lx, y: ly }); 
                } 
                ctx.stroke(); 

                // 2. 테두리 안쪽에 진짜 색상(검은색)을 덮어서 그림
                lx = line.x;
                ly = line.y;
                ctx.lineWidth = line.thickness; 
                ctx.strokeStyle = LINE_COLOR;
                ctx.beginPath();
                ctx.moveTo(lx, ly);

                vertices.forEach(vertex => ctx.lineTo(vertex.x, vertex.y));
                ctx.stroke(); 
            });

            time += windSpeed;
            animationId = requestAnimationFrame(draw);
        }

        
    })();
</script>