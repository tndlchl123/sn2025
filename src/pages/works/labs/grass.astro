---
import Layout from '@common/Design-Layout.astro';
---

<Layout title="grass">
    <div class="modal-inner-data">
        <div class="canvas-wrap">
            <canvas id="artCanvas"></canvas>
        </div>
    </div>
</Layout>

<style is:global>
    .works-modal-box {
        border-radius: var(--rad);
    }

    .canvas-wrap {
        /* 모달 박스 크기에 빈틈없이 100% 맞도록 변경 */
        width: 100%;
        height: 100%;
        position: relative;
        background-color: #394522;
        overflow: hidden;

        --canvas-line-color: #84944e;
        --canvas-outline-color: rgba(0, 0, 0, 0.8);
    }

    canvas {
        width: 100%;
        height: 100%;
        display: block;
    }
</style>

<script is:inline>
    (function() {
        const canvas = document.getElementById('artCanvas');
        const wrap = document.querySelector('.canvas-wrap'); 
        if (!canvas || !wrap) return;

        const ctx = canvas.getContext('2d');

        const wrapStyle = getComputedStyle(wrap);
        const LINE_COLOR = wrapStyle.getPropertyValue('--canvas-line-color').trim() || '#111111';
        const OUTLINE_COLOR = wrapStyle.getPropertyValue('--canvas-outline-color').trim() || '#ffffff';

        let lines = [];
        let time = 0;
        
        const lineCount = 5000;
        const windSpeed = 0.02;
        const windScale = 0.004;

        let animationId;

        function initLines(width, height) {
            lines = [];
            for (let i = 0; i < lineCount; i++) {
                lines.push({
                    x: Math.random() * width,        
                    y: Math.random() * height,       
                    length: Math.random() * 100 + 50, 
                    thickness: Math.random() * 2 + 1  
                });
            }
        }

        const resizeObserver = new ResizeObserver(entries => {
            const rect = entries[0].contentRect;
            if (rect.width === 0 || rect.height === 0) return;

            const dpr = window.devicePixelRatio || 1; 
            const newWidth = Math.round(rect.width * dpr);
            const newHeight = Math.round(rect.height * dpr);

            if (canvas.width !== newWidth || canvas.height !== newHeight) {
                canvas.width = newWidth;
                canvas.height = newHeight;
                
                // 창 크기 변경 시 스케일이 중복으로 곱해지는 현상 방지
                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
                
                initLines(rect.width, rect.height);
                
                if (!animationId) {
                    draw();
                }
            }
        });

        resizeObserver.observe(wrap);

        function draw() {
            if (!document.getElementById('artCanvas')) return; 

            const width = canvas.width;
            const height = canvas.height;

            ctx.clearRect(0, 0, width, height);
            
            ctx.lineCap = 'round'; 
            ctx.lineJoin = 'round'; 

            lines.forEach(line => {
                let lx = line.x;
                let ly = line.y;

                // 1. 테두리 그리기
                ctx.lineWidth = line.thickness + 1; 
                ctx.strokeStyle = OUTLINE_COLOR;
                ctx.beginPath();
                ctx.moveTo(lx, ly);

                let vertices = []; 
                for (let step = 0; step < line.length; step += 5) {
                    let angle = Math.sin(lx * windScale + time) * 1.2 + 
                                Math.cos(ly * windScale + time * 0.8) * 1.2 - 
                                Math.PI / 4;
                    lx += Math.cos(angle) * 5;
                    ly += Math.sin(angle) * 5;
                    ctx.lineTo(lx, ly);
                    vertices.push({ x: lx, y: ly }); 
                } 
                ctx.stroke(); 

                // 2. 메인 선 그리기
                lx = line.x;
                ly = line.y;
                ctx.lineWidth = line.thickness; 
                ctx.strokeStyle = LINE_COLOR;
                ctx.beginPath();
                ctx.moveTo(lx, ly);

                vertices.forEach(vertex => ctx.lineTo(vertex.x, vertex.y));
                ctx.stroke(); 
            });

            time += windSpeed;
            animationId = requestAnimationFrame(draw);
        }
    })();
</script>