<script is:inline>
    (function() {
        // 1. 초기 실행 및 테마/언어 적용 함수
        function applyInstantSettings() {
            const theme = localStorage.getItem('theme');
            const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            
            if (theme === 'dark' || (!theme && systemDark)) {
                document.documentElement.classList.add('dark-mode');
            } else {
                document.documentElement.classList.remove('dark-mode');
            }

            const savedLang = localStorage.getItem('lang') || 'ko';
            document.documentElement.classList.toggle('lang-en', savedLang === 'en');
        }

        // 즉시 실행 (최초 로드 시 흰 화면 방지)
        applyInstantSettings();

        // 🔥 2. Astro View Transitions 사용 시 페이지가 바뀌기 직전/직후에 깜빡임 없이 즉시 적용
        document.addEventListener('astro:before-preparation', applyInstantSettings);
        document.addEventListener('astro:after-swap', applyInstantSettings);
    })();
</script>

