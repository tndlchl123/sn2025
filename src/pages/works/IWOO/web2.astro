<!-- 푸터 CSS (INTERSECTION WORKS OF OBJECT -> IWOO 합체 모션 포함) -->
<style>
    /* 하단 고정형 리빌 푸터 기본 설정: 영문/숫자는 Lilex, 한글은 학교안심 바른돋움으로 자동 매칭 */
    .reveal-footer {
        --ft-font: 'Lilex', 'HakgyoansimBareondotumR', sans-serif;
        --ft-size: 0.8rem;
        --ft-line-gap: 4px;
        --ft-color: var(--hd-color);
        --ft-letter-spacing: 0em;

        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background-color: var(--bg-color);
        z-index: 1;
        overflow: hidden;
        font-family: var(--ft-font);
        font-size: var(--ft-size);
        font-weight: 400;
        color: var(--ft-color);
        letter-spacing: var(--ft-letter-spacing);
    }

    /* 푸터 내부 컨테이너: 상단 그라디언트 높이(--footer-fade)만큼 상단 패딩을 추가해 카피라이트와 푸터 인포가 가려지지 않도록 여유 공간 확보 */
    .footer-inner {
        width: 100%;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: calc(var(--pad) + var(--footer-fade) + 2vh) var(--pad) var(--pad);
        box-sizing: border-box;
    }

    /* 푸터 상단 텍스트 정보 영역 배치 */
    .footer-content {
        width: 100%;
        margin-bottom: 3vh;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    /* 푸터 우측 정보 그룹 묶음 */
    .footer-right-group {
        display: flex;
        gap: 6vw;
        align-items: flex-end;
    }

    /* 저작권 문구 및 우측 텍스트 스타일 */
    .footer-copy,
    .footer-copy p,
    .footer-links span,
    .footer-info p,
    .footer-contact p {
        margin: 0;
        font-family: var(--ft-font);
        font-size: var(--ft-size);
        font-weight: 400;
        color: var(--ft-color);
        letter-spacing: var(--ft-letter-spacing);
    }

    /* 링크, 사업자 정보, 연락처 세로 정렬 및 글자 길이에 맞춰 폭 고정 */
    .footer-links,
    .footer-info,
    .footer-contact {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--ft-line-gap);
        text-align: left;
    }

    /* 호버 언더라인 효과를 위한 상대 위치 및 글자 폭 맞춤 지정 */
    .footer-links span,
    .footer-contact p {
        position: relative;
        display: inline-block;
        width: fit-content;
        cursor: pointer;
    }

    /* 호버 시 나타나는 하단 밑줄 기본 상태 (:root의 --underline-thickness 변수로 두께 통일) */
    .footer-links span::after,
    .footer-contact p::after {
        content: '';
        position: absolute;
        bottom: var(--underline-offset);
        left: 0;
        width: 0;
        height: var(--underline-thickness);
        background-color: currentColor;
        transform: translateZ(0);
        transition: width 0.5s var(--motion);
    }

    /* 호버 시 모든 항목 동일하게 글자 폭 100%만큼 밑줄 생성 */
    .footer-links span:hover::after,
    .footer-contact p:hover::after {
        width: 100%;
    }

    /* 푸터 하단 모핑 SVG 크기 설정 */
    .reveal-footer svg.footer-morph-svg {
        display: block;
        width: 100%;
        margin: 0 auto;
        height: auto;
        overflow: visible;
    }

    /* 푸터 로고 패스 색상 지정 */
    .footer-logo {
        fill: var(--hd-color);
        stroke: none;
    }

    /* INTERSECTION WORKS OF OBJECT 중 I, W, O, O를 제외한 나머지 글자 트랜지션 */
    .rest-char {
        opacity: 1;
        transition: opacity 0.65s var(--motion);
    }

    /* I, W, O, O 네 글자 기본 상태 (원래 문장 내 위치 및 크기) */
    .iwoo-char {
        transform-origin: 0px 0px;
        transform: translate(0px, 0px) scale(1);
        transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
        will-change: transform;
    }

    /* 푸터가 일정 비율 이상 노출되어 .is-merged가 붙었을 때 나머지 글자는 사라지고 I, W, O, O가 기존 대형 로고 크기로 합쳐짐 */
    .reveal-footer.is-merged .rest-char {
        opacity: 0;
        pointer-events: none;
    }

    .reveal-footer.is-merged .iwoo-i {
        transform: translate(3.3px, -187.4px) scale(5.986);
    }

    .reveal-footer.is-merged .iwoo-w {
        transform: translate(-1869.7px, -185.3px) scale(5.96);
    }

    .reveal-footer.is-merged .iwoo-o1 {
        transform: translate(-2656.5px, -188.7px) scale(5.96);
    }

    .reveal-footer.is-merged .iwoo-o2 {
        transform: translate(-2878.2px, -188.7px) scale(5.96);
    }

    /* 모바일 환경에서 푸터의 모든 그룹을 세로(column)로 차례대로 쌓이도록 정렬 */
    @media (max-width: 768px) {
        .footer-content {
            flex-direction: column;
            align-items: flex-start;
            gap: 2vh;
        }

        .footer-right-group {
            width: 100%;
            flex-direction: column;
            align-items: flex-start;
            gap: 2vh;
        }
    }
</style>

<!-- 다국어 번역 스크립트 -->
<script is:inline>
    // 1. 다국어 제어 함수 (갤러리 스크립트에서도 함께 사용함)
    function getCurrentLang() {
        return document.documentElement.classList.contains('lang-en') ? 'en' : 'ko';
    }

    function getCaptionText(img) {
        if (!img) return '';
        const lang = getCurrentLang();
        return lang === 'en' ? (img.dataset.en || img.dataset.ko || '') : (img.dataset.ko || img.dataset.en || '');
    }

    function updatePageTranslations() {
        // 현재 설정된 언어('en' 또는 'ko')를 가져옴
        const lang = getCurrentLang();

        // 페이지 내 번역이 필요한 모든 요소를 순회함
        const translatableElements = document.querySelectorAll('[data-ko][data-en]');
        translatableElements.forEach((el) => {
            // 이미지는 번역 대상이 아니므로 제외함
            if (el.tagName === 'IMG') return;

            // 헤더나 필터 영역은 수작업으로 관리되므로 일반 텍스트로 교체함
            if (el.closest('.main-header') || el.closest('.filter-container')) {
                const text = lang === 'en' ? el.dataset.en : el.dataset.ko;
                if (text !== undefined) {
                    el.innerHTML = text;
                }
                return;
            }


            // 만약 아직 롤링 껍데기가 씌워지지 않은 최초 상태라면 롤링 HTML 구조를 생성하여 삽입함
            const ko = el.getAttribute('data-ko') || '';
            const en = el.getAttribute('data-en') || '';
            if (typeof window.buildRollingHTML === 'function' && (ko || en)) {
                el.innerHTML = window.buildRollingHTML(ko, en);
            }
        });

        // 현재 활성화된 갤러리 캡션을 롤링 구조로 즉시 업데이트함
        const activeImg = document.querySelector('.gallery-item.is-active img');
        const captionEl = document.getElementById('galleryCaption');
        if (captionEl && activeImg) {
            const ko = activeImg.getAttribute('data-ko') || '';
            const en = activeImg.getAttribute('data-en') || '';
            
            if (typeof window.buildRollingHTML === 'function') {
                captionEl.innerHTML = window.buildRollingHTML(ko, en);
            } else {
                captionEl.innerHTML = getCaptionText(activeImg);
            }
        }
    }

    // 2. 다국어 초기화 및 토글 이벤트
    function initTranslation() {
        const savedLang = localStorage.getItem('lang') || 'ko';
        document.documentElement.classList.toggle('lang-en', savedLang === 'en');
        updatePageTranslations();

        const langBtn = document.getElementById('langToggle');
        if (langBtn && langBtn.dataset.initLang !== 'true') {
            langBtn.dataset.initLang = 'true';
            langBtn.addEventListener('click', (e) => {
                e.preventDefault();
                const isEn = document.documentElement.classList.toggle('lang-en');
                localStorage.setItem('lang', isEn ? 'en' : 'ko');
                updatePageTranslations();
            });
        }
    }

    document.addEventListener('astro:page-load', initTranslation);
    document.addEventListener('DOMContentLoaded', initTranslation);
</script>

<!-- 헤더 메뉴 theme 버튼 기반 다크모드 토글 스크립트 -->
<script is:inline>
    document.addEventListener('DOMContentLoaded', initThemeToggle);
    document.addEventListener('astro:page-load', initThemeToggle);

    function applySavedOrSystemTheme() {
        const savedTheme = localStorage.getItem('theme');
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const shouldBeDark = savedTheme === 'dark' || (!savedTheme && systemPrefersDark);

        document.documentElement.classList.toggle('dark-mode', shouldBeDark);
    }

    function initThemeToggle() {
        applySavedOrSystemTheme();

        const themeBtn = document.getElementById('themeToggle');
        if (!themeBtn || themeBtn.dataset.initTheme === 'true') return;
        themeBtn.dataset.initTheme = 'true';

        // 헤더의 theme 메뉴 클릭 시 다크모드/라이트모드 전환 및 상태 저장
        themeBtn.addEventListener('click', (e) => {
            e.preventDefault();
            const isDark = document.documentElement.classList.toggle('dark-mode');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
    }
</script>

<!-- 문의 메뉴 하단 아코디언 펼침 제어 스크립트 -->
<script is:inline>
    document.addEventListener('DOMContentLoaded', initContactDropdown);
    document.addEventListener('astro:page-load', initContactDropdown);

    function initContactDropdown() {
        const openBtn = document.getElementById('openContact');
        const dropdown = document.getElementById('contactPopup');
        const contactGroup = document.getElementById('contactGroup');

        if (!openBtn || !dropdown || openBtn.dataset.initPopup === 'true') return;
        openBtn.dataset.initPopup = 'true';

        // 문의 메뉴 클릭 시 바로 아래 숨겨진 문의 영역을 부드럽게 펼치거나 접기
        openBtn.addEventListener('click', (e) => {
            e.preventDefault();
            const isOpen = dropdown.classList.toggle('is-active');
            openBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });

        // 문의 영역 바깥을 클릭하면 자동으로 접기
        document.addEventListener('click', (e) => {
            if (dropdown.classList.contains('is-active') && contactGroup && !contactGroup.contains(e.target)) {
                dropdown.classList.remove('is-active');
                openBtn.setAttribute('aria-expanded', 'false');
            }
        });

        // ESC 키 입력 시 접기
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && dropdown.classList.contains('is-active')) {
                dropdown.classList.remove('is-active');
                openBtn.setAttribute('aria-expanded', 'false');
            }
        });
    }
</script>

<!-- 리빌 푸터 높이 동기화 및 스크롤 노출 감지(IWOO 합체 모션 트리거) 스크립트 -->
<script is:inline>
    function syncFooterAndScroll() {
        const footer = document.querySelector('.reveal-footer');
        const wrapper = document.querySelector('.content-wrapper');
        const footerInner = document.querySelector('.footer-inner');

        if (!footer || !wrapper || !footerInner) return;

        const footerHeight = footer.offsetHeight;
        wrapper.style.marginBottom = footerHeight + 'px';

        const wrapperRect = wrapper.getBoundingClientRect();
        const revealedPx = window.innerHeight - wrapperRect.bottom;
        const paddingTop = parseFloat(window.getComputedStyle(footerInner).paddingTop) || 0;
        
        const actualContentHeight = footerHeight - paddingTop;
        const actualRevealedPx = Math.max(0, revealedPx - paddingTop);

        // 스크롤 비율 (0: 안 보임 ~ 1: 다 보임)
        let revealRatio = actualContentHeight > 0 ? actualRevealedPx / actualContentHeight : 0;
        revealRatio = Math.max(0, Math.min(1, revealRatio));

        /* ====================================================
           💡 대표님이 CSS에 적어둔 수치를 그대로 가져와서 스크롤에 곱해줍니다.
           (CSS 파일은 건드릴 필요가 전혀 없습니다!)
           ==================================================== */
        
        const iwooI = footer.querySelector('.iwoo-i');
        const iwooW = footer.querySelector('.iwoo-w');
        const iwooO1 = footer.querySelector('.iwoo-o1');
        const iwooO2 = footer.querySelector('.iwoo-o2');
        const restChars = footer.querySelectorAll('.rest-char');

        if (iwooI && iwooW && iwooO1 && iwooO2) {
            // 마우스 휠에 즉각적으로(렉 없이) 반응하게 CSS transition 끄기
            iwooI.style.transition = 'none';
            iwooW.style.transition = 'none';
            iwooO1.style.transition = 'none';
            iwooO2.style.transition = 'none';
            
            // 대표님의 완벽한 수치에 revealRatio(스크롤 퍼센트)를 곱해서 위치를 실시간 조작
            iwooI.style.transform = `translate(${3.3 * revealRatio}px, ${-187.4 * revealRatio}px) scale(${1 + (4.986 * revealRatio)})`;
            iwooW.style.transform = `translate(${-1869.7 * revealRatio}px, ${-185.3 * revealRatio}px) scale(${1 + (4.96 * revealRatio)})`;
            iwooO1.style.transform = `translate(${-2656.5 * revealRatio}px, ${-188.7 * revealRatio}px) scale(${1 + (4.96 * revealRatio)})`;
            iwooO2.style.transform = `translate(${-2878.2 * revealRatio}px, ${-188.7 * revealRatio}px) scale(${1 + (4.96 * revealRatio)})`;
        }

        // 안 쓰는 글자들(rest-char)도 스크롤 내릴수록 서서히 사라지게 조작
        restChars.forEach(char => {
            char.style.transition = 'none';
            char.style.opacity = 1 - revealRatio;
            char.style.pointerEvents = revealRatio > 0.5 ? 'none' : 'auto';
        });
    }

    function initFooterReveal() {
        syncFooterAndScroll();
        const footer = document.querySelector('.reveal-footer');
        if (footer && 'ResizeObserver' in window && footer.dataset.observed !== 'true') {
            footer.dataset.observed = 'true';
            const observer = new ResizeObserver(() => syncFooterAndScroll());
            observer.observe(footer);
        }
    }

    document.addEventListener('DOMContentLoaded', initFooterReveal);
    document.addEventListener('astro:page-load', initFooterReveal);
    window.addEventListener('resize', syncFooterAndScroll);
    window.addEventListener('scroll', syncFooterAndScroll, { passive: true });
</script>

<!-- 필터링 -->
<script is:inline>
if (typeof document !== 'undefined') {
  const initGalleryFilter = () => {
    const grid = document.querySelector('.grid-gallery');
    const filterItems = document.querySelectorAll('.filter-item');
    const galleryItems = document.querySelectorAll('.grid-item');

    if (!grid || !filterItems.length || !galleryItems.length) return;

    let filterTimeout;

    // CSS 전환 속도를 동적으로 읽어오기 (기본 400ms)
    const getMotionDuration = (el) => {
      const durationStr = window.getComputedStyle(el).transitionDuration.split(',')[0].trim();
      if (!durationStr) return 400;
      if (durationStr.endsWith('ms')) return parseFloat(durationStr) || 400;
      if (durationStr.endsWith('s')) return (parseFloat(durationStr) * 1000) || 400;
      return 400;
    };

    const runFilter = (selectedCategory) => {
      let hasVanishingItems = false;

      // 1단계: 조건에 맞지 않는 아이템에 페이드아웃 클래스 부여
      galleryItems.forEach(card => {
        const cardCategory = card.dataset.category || '';
        const isMatch = (selectedCategory === 'all') || cardCategory.split(' ').includes(selectedCategory);

        if (!card.classList.contains('is-hidden') && !isMatch) {
          card.classList.add('is-vanishing');
          hasVanishingItems = true;
        } else if (isMatch) {
          card.classList.remove('is-vanishing');
        }
      });

      // 페이드아웃 애니메이션 시간이 끝난 뒤 자리를 재배치하도록 딜레이 계산
      const delay = hasVanishingItems ? getMotionDuration(galleryItems[0]) : 0;

      clearTimeout(filterTimeout);
      filterTimeout = setTimeout(() => {
        // 2단계: 화면에 남아있는 아이템들의 이동 전 위치(First) 기록
        const firstRects = new Map();
        galleryItems.forEach(card => {
          const cardCategory = card.dataset.category || '';
          const isMatch = (selectedCategory === 'all') || cardCategory.split(' ').includes(selectedCategory);
          if (!card.classList.contains('is-hidden') && isMatch) {
            firstRects.set(card, card.getBoundingClientRect());
          }
        });

        // 3단계: 실제 보임/숨김 상태 반영 (Last)
        galleryItems.forEach(card => {
          const cardCategory = card.dataset.category || '';
          const isMatch = (selectedCategory === 'all') || cardCategory.split(' ').includes(selectedCategory);

          if (!isMatch) {
            card.classList.add('is-hidden');
            card.classList.remove('is-vanishing');
          } else {
            card.classList.remove('is-hidden');
            card.classList.remove('is-vanishing');
          }
        });

        // 4단계: 이동 거리 계산 및 시작 위치 고정 (Invert)
        galleryItems.forEach(card => {
          if (card.classList.contains('is-hidden')) return;

          const first = firstRects.get(card);
          if (first) {
            const last = card.getBoundingClientRect();
            const dx = first.left - last.left;
            const dy = first.top - last.top;

            if (dx !== 0 || dy !== 0) {
              card.style.transition = 'none';
              card.style.transform = `translate3d(${dx}px, ${dy}px, 0)`;
            }
          }
        });

        // 5단계: 브라우저 리플로우 후 제자리로 부드럽게 슬라이드 이동 (Play)
        void grid.offsetHeight;

        galleryItems.forEach(card => {
          if (card.classList.contains('is-hidden')) return;
          card.style.transition = '';
          card.style.transform = '';
        });
      }, delay);
    };

    filterItems.forEach(filterBtn => {
      if (filterBtn.dataset.filterInit === 'true') return;
      filterBtn.dataset.filterInit = 'true';

      filterBtn.addEventListener('click', (e) => {
        e.preventDefault();

        // 버튼 활성화 클래스 교체
        filterItems.forEach(el => el.classList.remove('is-active'));
        filterBtn.classList.add('is-active');

        const selectedCategory = filterBtn.dataset.filter || 'all';
        runFilter(selectedCategory);
      });
    });
  };

  document.addEventListener('DOMContentLoaded', initGalleryFilter);
  document.addEventListener('astro:page-load', initGalleryFilter);
}
</script>

<!-- 지도 복사 -->
<script is:inline>
    function copyAddress(el) {
        if (el.classList.contains('is-copied')) return;

        const address = "경기도 이천시 신둔면 도자예술로 99번길";
        
        const showMessage = () => {
            el.classList.add('is-copied');
            setTimeout(() => el.classList.remove('is-copied'), 3000);
        };

        // 1. 최신 브라우저 & HTTPS 환경일 때
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(address)
                .then(showMessage)
                .catch(err => console.error('복사 실패:', err));
        } 
        // 2. HTTP 환경이나 로컬 테스트(IP 접속) 중일 때 우회 처리
        else {
            const textArea = document.createElement("textarea");
            textArea.value = address;
            textArea.style.position = "absolute";
            textArea.style.opacity = "0";
            document.body.appendChild(textArea);
            textArea.select();
            
            try {
                document.execCommand('copy');
                showMessage();
            } catch (err) {
                console.error('우회 복사 실패:', err);
            }
            
            document.body.removeChild(textArea);
        }
    }
</script>

