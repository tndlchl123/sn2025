---
import Layout from '@common/Design-Layout.astro';
import GalleryItems from './GallaryItems.astro';
---

<Layout title="IWOO">
<div class="content-wrapper">
    <header class="main-header">
        <!-- 1. 부모 <a> 태그에 aria-label="이우" 지정 -->
        <a href="/works/IWOO/web" class="header-logo menu-item" aria-label="이우">
            <!-- 내부는 시각적 효과만 담당하므로 스크린 리더는 완전히 무시하게 됨 -->
            <span class="word kr" aria-hidden="true">
                <span class="char">이</span><span class="char">우</span>
            </span>
            <span class="word en" aria-hidden="true">
                <span class="char">i</span><span class="char">w</span><span class="char">o</span><span class="char">o</span>
            </span>
        </a>
        
        <nav class="header-menu">
            <!-- 2. 컬렉션 -->
            <a href="/works/IWOO/web2" class="menu-item" aria-label="컬렉션">
                <span class="word kr" aria-hidden="true"><span class="char">컬</span><span class="char">렉</span><span class="char">션</span></span>
                <span class="word en" aria-hidden="true"><span class="char">c</span><span class="char">o</span><span class="char">l</span><span class="char">l</span><span class="char">e</span><span class="char">c</span><span class="char">t</span><span class="char">i</span><span class="char">o</span><span class="char">n</span></span>
            </a>

            <!-- 3. 문의 -->
            <div class="contact-menu-group" id="contactGroup">
                <a href="#contact" class="menu-item" id="openContact" aria-expanded="false" role="button" aria-controls="contactPopup" aria-label="문의">
                    <span class="word kr" aria-hidden="true"><span class="char">문</span><span class="char">의</span></span>
                    <span class="word en" aria-hidden="true"><span class="char">c</span><span class="char">o</span><span class="char">n</span><span class="char">t</span><span class="char">a</span><span class="char">c</span><span class="char">t</span></span>
                </a>

                <div class="contact-dropdown" id="contactPopup">
                    <div class="contact-dropdown-inner">
                        <div class="popup-info">
                            <a href="tel:010-0000-0000" class="contact-link">010-0000-0000</a>
                            <a href="mailto:hello@iwoo.ceramic" class="contact-link">hello@iwoo.ceramic</a>
                            <a href="#" class="contact-link">@iwoo.official</a>
                        </div>
                        <div class="map-placeholder" onclick="copyAddress(this)" role="button" tabindex="0">
                            <span class="map-msg" data-ko="복사되었습니다" data-en="Copied">복사되었습니다</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. 테마 변경 -->
            <a href="#theme" class="menu-item" id="themeToggle" role="button" aria-label="테마 변경">
                <span class="word kr" aria-hidden="true">
                    <span class="char">테</span><span class="char">마</span>
                </span>
                <span class="word en" aria-hidden="true">
                    <span class="char">t</span><span class="char">h</span><span class="char">e</span><span class="char">m</span><span class="char">e</span>
                </span>
            </a>
            
            <!-- 5. 언어 전환 -->
            <a href="#lang" class="menu-item" id="langToggle" role="button" aria-label="언어 전환">
                <span class="word kr" aria-hidden="true">
                    <span class="char">한</span><span class="char">글</span>
                </span>
                <span class="word en" aria-hidden="true">
                    <span class="char">e</span><span class="char">n</span><span class="char">g</span>
                </span>
            </a>
        </nav>
    </header>

    <div class="filter-container">
        <nav class="filter-bar" aria-label="카테고리 필터">
            <a href="#all" class="filter-item menu-item is-active" data-filter="all" aria-label="전체보기">
                <span class="word kr" aria-hidden="true"><span class="char">전</span><span class="char">체</span><span class="char">보</span><span class="char">기</span></span>
                <span class="word en" aria-hidden="true"><span class="char">a</span><span class="char">l</span><span class="char">l</span></span>
            </a>
            
            <a href="#ceramic" class="filter-item menu-item" data-filter="ceramic" aria-label="도자기">
                <span class="word kr" aria-hidden="true"><span class="char">도</span><span class="char">자</span><span class="char">기</span></span>
                <span class="word en" aria-hidden="true"><span class="char">c</span><span class="char">e</span><span class="char">r</span><span class="char">a</span><span class="char">m</span><span class="char">i</span><span class="char">c</span></span>
            </a>
            
            <a href="#archive" class="filter-item menu-item" data-filter="archive" aria-label="아카이브">
                <span class="word kr" aria-hidden="true"><span class="char">아</span><span class="char">카</span><span class="char">이</span><span class="char">브</span></span>
                <span class="word en" aria-hidden="true"><span class="char">a</span><span class="char">r</span><span class="char">c</span><span class="char">h</span><span class="char">i</span><span class="char">v</span><span class="char">e</span></span>
            </a>
        </nav>
    </div>

    <main class="main-content">
        <section class="grid-gallery">
            <GalleryItems />
        </section>
    </main>
</div>

<!-- 4. 리빌 푸터 영역 (스크롤 시 INTERSECTION WORKS OF OBJECT에서 I, W, O, O가 대형 로고로 합쳐짐) -->
<footer class="reveal-footer" id="revealFooter">
    <div class="footer-inner">
        <div class="footer-content">
            <div class="footer-copy">
                <p>&copy; 2026</p>
            </div>
            <div class="footer-right-group">
                <!-- 
                <div class="footer-links">
                    <a href="#terms" data-ko="이용약관" data-en="Terms of Use" aria-label="이용약관">이용약관</a>
                    <a href="#privacy" data-ko="개인정보처리방침" data-en="Privacy Policy" aria-label="개인정보처리방침">개인정보처리방침</a>
                </div>
                -->
                <div class="footer-info">
                    <!-- 단순 텍스트 단락에도 aria-label을 부여해 통째로 읽히게 함 -->
                    <p data-ko="대표 홍길동" data-en="CEO Hong Gildong" aria-label="대표 홍길동">대표 홍길동</p>
                    <p data-ko="사업자등록번호 123-45-67890" data-en="Business License 123-45-67890" aria-label="사업자등록번호 123-45-67890">사업자등록번호 123-45-67890</p>
                </div>
                <div class="footer-contact">
                    <p><a href="mailto:info@iwoo.kr">info@iwoo.kr</a></p>
                    <p><a href="https://instagram.com/iwoo.official" target="_blank" rel="noopener noreferrer" aria-label="이우 공식 인스타그램">@iwoo.official</a></p>
                </div>
            </div>
        </div>

        <!-- 3. 핵심: 모핑 SVG가 스크린 리더에 수많은 좌표로 낭독되지 않도록 완전히 숨김 -->
