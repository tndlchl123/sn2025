<style is:global>
    /* 오버플로우 마스킹 (껍데기 밖으로 나가면 잘림) */
    .r-mask {
        display: inline-block;
        position: relative;
        overflow: hidden; 
        vertical-align: bottom;
    }
    .r-mask .r-word {
        display: inline-block;
        white-space: nowrap; /* 🔥 폰에서 글자가 쪼개지는 현상 방지 */
    }
    .r-mask .r-char {
        display: inline-block;
        transition: transform 0.5s var(--motion);
    }
    
    /* [기본 상태: 한글] 영문은 110% 아래에 대기 */
    .r-mask .r-word.kr { position: relative; }
    .r-mask .r-word.en { position: absolute; left: 0; top: 0; pointer-events: none; }
    .r-mask .r-word.kr .r-char { transform: translateY(0); }
    .r-mask .r-word.en .r-char { transform: translateY(110%); }
    
    /* [전환 상태: 영문] 한글은 -110% 위로 밀려남 */
    html.lang-en .r-mask .r-word.kr { position: absolute; left: 0; top: 0; pointer-events: none; }
    html.lang-en .r-mask .r-word.en { position: relative; left: auto; top: auto; pointer-events: auto; }
    html.lang-en .r-mask .r-word.kr .r-char { transform: translateY(-110%); }
    html.lang-en .r-mask .r-word.en .r-char { transform: translateY(0); }

    /* 🔥 [핵심 추가] 글자가 없는 껍데기(투명 인간)는 아예 화면에서 삭제해버림! */
    html:not(.lang-en) .r-mask.empty-kr { display: none !important; }
    html.lang-en .r-mask.empty-en { display: none !important; }
</style>

<!-- 번역: 롤링 애니메이션 -->
<script is:inline>
    window.buildRollingHTML = function(koStr, enStr) {
        // 🔥 1. 끝에 실수로 들어간 스페이스바 띄어쓰기를 완벽하게 잘라냄 (trim)
        const kWords = (koStr || '').trim().split(/\s+/);
        const eWords = (enStr || '').trim().split(/\s+/);
        const maxWords = Math.max(kWords.length, eWords.length);

        let lineHtml = [];
        for (let j = 0; j < maxWords; j++) {
            const wrapChars = (word) => {
                let charIdx = 0;
                return Array.from(word).map(c => {
                    const delay = (charIdx * 0.02).toFixed(3);
                    charIdx++;
                    const safeChar = c.replace(/"/g, '&quot;');
                    return `<span class="r-char" style="transition-delay: ${delay}s">${safeChar}</span>`;
                }).join('');
            };

            const kW = wrapChars(kWords[j] || '');
            const eW = wrapChars(eWords[j] || '');

            // 🔥 2. 단어가 비어있으면 empty-kr, empty-en 이라는 꼬리표(클래스)를 달아줍니다!
            let maskClass = 'r-mask';
            if (!kWords[j]) maskClass += ' empty-kr';
            if (!eWords[j]) maskClass += ' empty-en';

            lineHtml.push(`<span class="${maskClass}"><span class="r-word kr">${kW}</span><span class="r-word en">${eW}</span></span>`);
        }

        // 🔥 3. 골칫덩어리였던 flex와 gap을 지우고, 진짜 띄어쓰기(' ')로 단어들을 이어붙입니다.
        return `<span class="r-lines-container">${lineHtml.join(' ')}</span>`;
    };

    window.getCaptionText = function(img) {
        if (!img) return '';
        const ko = img.getAttribute('data-ko') || '';
        const en = img.getAttribute('data-en') || '';
        return window.buildRollingHTML(ko, en);
    };

    window.updatePageTranslations = function() {
        const lang = document.documentElement.classList.contains('lang-en') ? 'en' : 'ko';

        document.querySelectorAll('[data-ko][data-en]').forEach(el => {
            if (el.tagName === 'IMG' || el.tagName === 'VIDEO') return;

            if (el.closest('.main-header') || el.closest('.filter-container')) {
                el.innerHTML = lang === 'en' ? el.getAttribute('data-en') : el.getAttribute('data-ko');
                return;
            }

            if (!el.dataset.rolled) {
                el.innerHTML = window.buildRollingHTML(el.getAttribute('data-ko'), el.getAttribute('data-en'));
                el.dataset.rolled = 'true';
            }
        });

        // 현재 열려있는 갤러리 아이템 캡션 업데이트
        const activeItem = document.querySelector('.gallery-item.is-active');
        const activeMedia = activeItem ? activeItem.querySelector('img, video') : null;
        const captionEl = activeItem ? activeItem.querySelector('.item-caption') : null;
        if (captionEl && activeMedia) {
            captionEl.innerHTML = window.getCaptionText(activeMedia);
        }
    };

    function initAll() {
        const savedLang = localStorage.getItem('lang') || 'ko';
        const isEn = savedLang === 'en';
        document.documentElement.classList.toggle('lang-en', isEn);

        if (typeof window.updatePageTranslations === 'function') {
            window.updatePageTranslations();
        }
    }

    document.addEventListener('astro:page-load', initAll);
    document.addEventListener('DOMContentLoaded', initAll);
</script>