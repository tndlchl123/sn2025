<!-- 공통 변수 및 다크모드 설정 CSS -->
<style>
    :root {
        --pad: 1vw;
        --gap: 1vh;
        --align-point: 35vw;

        /* 기본 라이트 모드 색상 변수 */
        --bg-color: rgba(245, 245, 245, 1);
        --hd-color: rgba(0, 0, 0, 1);
        --bg-color-r: 245, 245, 245;

        /* 모션 및 타이포그래피 변수 */
        --motion: cubic-bezier(0.5, 0, 0, 1);
        --gallery-ease: cubic-bezier(0.25, 0.1, 0.25, 1);
        --main-font-size: 1rem;
        --hd-line-height: 1.3;
        --hd-letter-spacing: -0.02em;

        /* 갤러리 블러 해제 속도 (이 변수만 바꾸면 사진과 캡션 전환 속도가 함께 변경됨) */
        --gallery-speed: 3s;

        /* 푸터 호버 밑줄 두께 및 간격 통합 제어 변수 */
        --underline-thickness: 1px;
        --underline-offset: -2px;

        /* 리빌 푸터 상단 경계 그라디언트 높이 */
        --footer-fade: 15vh;
    }

    /* 모바일 환경에서 여백이 너무 얇아지지 않도록 패딩과 간격 조정 */
    @media (max-width: 768px) {
        :root {
            --pad: 4vw;
            --gap: 1.2vh;
        }
    }

    /* 다크 모드 활성화 시 색상 변수 덮어쓰기 */
    html.dark-mode {
        --bg-color: rgba(18, 18, 18, 1);
        --hd-color: rgba(245, 245, 245, 1);
        --bg-color-r: 18, 18, 18;
    }

    /* 모바일 브라우저가 임의로 텍스트 크기를 확대하지 않도록 고정 */
    html,
    body {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
    }

    /* 스크린 리더 전용 숨김 처리 */
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
    }

    /* 주요 영역 배경색 및 테마 전환 트랜지션 */
    html,
    body,
    .main-header,
    main,
    .reveal-footer {
        background-color: var(--bg-color);
        transition: background-color 0.8s cubic-bezier(0.25, 1, 0.5, 1), color 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    }

    /* 텍스트 컬러 공통 적용 */
    .header-logo,
    .header-menu,
    .word.en,
    .word.kr,
    .gallery-caption,
    .footer-copy,
    .footer-links,
    .footer-info,
    .footer-contact {
        color: var(--hd-color);
        transition: color 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    }

    /* 푸터 SVG 로고 색상 적용 */
    .footer-logo {
        fill: var(--hd-color);
        transition: fill 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    }

    
</style>

<!-- 상단 영역 CSS -->
<style>
    /* 전체 래퍼가 화면 높이를 최소 100vh 이상 차지하여 하단 고정 푸터를 덮도록 설정 */
    .content-wrapper {
        position: relative;
        z-index: 10;
        background-color: var(--bg-color);
        min-height: 100vh;
        transition: background-color 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .main-content {
        width: 100%;
    }

    /* 헤더 레이아웃 */
    .main-header {
        display: flex;
        align-items: flex-start;
        padding: var(--pad);
        width: 100%;
        box-sizing: border-box;
        z-index: 10;
        position: relative;
    }

    /* 로고 가로폭을 align-point(35vw)로 고정하여 메뉴 시작 위치 정렬 */
    .header-logo.menu-item {
        position: relative;
        display: inline-grid; /* 일반 메뉴와 똑같은 그리드 구조로 통일 */
        align-items: start;
        justify-items: start; /* 왼쪽 기준 정렬 확실히 고정 */
        overflow: hidden;
        text-decoration: none;
        cursor: pointer;
        height: 1.4rem; 
        width: var(--align-point);
        flex-shrink: 0;
        -webkit-tap-highlight-color: transparent;
    }


    .header-menu {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.15rem;
        font-family: 'Lilex', 'HakgyoansimBareondotumR', sans-serif;
        color: var(--hd-color);
    }

    /* 메뉴 아이템: inline-grid로 한글과 영문을 같은 셀(1/1)에 겹쳐 더 긴 단어(영문) 폭에 맞춰 가로폭이 자동 확보되게 설정 */
    .menu-item {
        position: relative;
        display: inline-grid;
        align-items: start;
        justify-items: start;
        overflow: hidden;
        text-decoration: none;
        cursor: pointer;
        height: 1.4rem;
        -webkit-tap-highlight-color: transparent;
    }

    .word {
        grid-area: 1 / 1;
        display: flex;
        justify-content: flex-start;
        white-space: nowrap;
        font-family: 'Lilex', 'HakgyoansimBareondotumR', sans-serif;
        font-size: var(--main-font-size);
        line-height: var(--hd-line-height);
        letter-spacing: var(--hd-letter-spacing);
        color: var(--hd-color);
    }

    /* 기본 상태에서는 한글(.word.kr)이 위에 보이고 영문(.word.en)이 2rem 아래에 대기 */
    .header-logo .word.kr,
    .word.kr {
        position: relative;
        top: 0;
    }

    .header-logo .word.en,
    .word.en {
        position: relative;
        top: 2rem;
    }

    .char {
        display: block;
        transition: transform 0.4s var(--motion);
    }

    /* 한글 상태에서 호버하면 위로 롤링되어 영문이 잘림 없이 나타남 */
    .menu-item:hover .word.kr .char,
    .menu-item:hover .word.en .char {
        transform: translateY(-2rem);
    }

    /* 언어 전환(eng) 활성화 시 영문이 기본으로 보이고 호버하면 한글이 나타남 */
    html.lang-en .menu-item .word.kr .char,
    html.lang-en .menu-item .word.en .char,
    .header-logo.menu-item:hover .word.en .char, 
    .header-logo.menu-item:hover .word.kr .char {
        transform: translateY(-2rem);
    }

    html.lang-en .menu-item:hover .word.kr .char,
    html.lang-en .menu-item:hover .word.en .char,
    .header-logo .char {
        transform: translateY(0);
    }

    .menu-item .char:nth-child(1) { transition-delay: 0.00s; }
    .menu-item .char:nth-child(2) { transition-delay: 0.03s; }
    .menu-item .char:nth-child(3) { transition-delay: 0.06s; }
    .menu-item .char:nth-child(4) { transition-delay: 0.09s; }
    .menu-item .char:nth-child(5) { transition-delay: 0.12s; }
    .menu-item .char:nth-child(6) { transition-delay: 0.15s; }
    .menu-item .char:nth-child(7) { transition-delay: 0.18s; }
    .menu-item .char:nth-child(8) { transition-delay: 0.21s; }
    .menu-item .char:nth-child(9) { transition-delay: 0.24s; }
    .menu-item .char:nth-child(10) { transition-delay: 0.27s; }

    /* 문의 메뉴 래퍼 */
    .contact-menu-group {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    /* 문의 메뉴 바로 밑에 높이 0으로 숨겨져 있다가 클릭 시 늘어나는 아코디언 영역 */
    .contact-dropdown {
        display: grid;
        grid-template-rows: 0fr;
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        margin-top: 0;
        margin-bottom: 0;
        transition:
            grid-template-rows 0.5s var(--motion),
            max-height 0.5s var(--motion),
            opacity 0.4s var(--motion),
            margin 0.5s var(--motion);
    }

    /* 문의 클릭 시 높이가 늘어나며 펼쳐진 상태 */
    .contact-dropdown.is-active {
        grid-template-rows: 1fr;
        max-height: 360px;
        opacity: 1;
        margin-top: 0.8vh;
        margin-bottom: 1.2vh;
    }

    .contact-dropdown-inner {
        min-height: 0;
        overflow: hidden;
