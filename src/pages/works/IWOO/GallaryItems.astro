<!-- img data-ko / data-en -> .item-caption 자동 주입 & 첫 번째 아이템 자동 활성화 스크립트 -->
<script is:inline>
function setupGalleryAndCaptions() {
    // 1. 그리드 뷰용: 각 아이템의 캡션 롤링 구조 생성 (최초 1회만)
    document.querySelectorAll('.grid-item').forEach(item => {
        const img = item.querySelector('img');
        const caption = item.querySelector('.item-caption');
        if (!img || !caption) return;

        // 이미 롤링 껍데기가 들어가 있다면 중복 생성 방지
        if (!caption.querySelector('.r-mask')) {
            const ko = img.getAttribute('data-ko') || '';
            const en = img.getAttribute('data-en') || '';
            
            if (typeof window.buildRollingHTML === 'function') {
                caption.innerHTML = window.buildRollingHTML(ko, en);
            } else {
                caption.innerHTML = ko; // 함수 로드 전 예외처리
            }
        }
    });

    // 2. 홈 1장 교체 갤러리용: 첫 번째 아이템 자동 is-active 지정 및 상단 캡션 갱신
    const singleItems = document.querySelectorAll('.single-gallery .gallery-item');
    if (singleItems.length > 0) {
        singleItems.forEach(el => el.classList.remove('is-active'));
        singleItems[0].classList.add('is-active');

        const captionContainer = document.getElementById('galleryCaption');
        const firstImg = singleItems[0].querySelector('img');
        if (firstImg && captionContainer) {
            // 여기도 마찬가지로 껍데기가 없을 때만 롤링 HTML 주입
            if (!captionContainer.querySelector('.r-mask')) {
                const ko = firstImg.getAttribute('data-ko') || '';
                const en = firstImg.getAttribute('data-en') || '';
                
                if (typeof window.buildRollingHTML === 'function') {
                    captionContainer.innerHTML = window.buildRollingHTML(ko, en);
                } else {
                    captionContainer.innerHTML = ko;
                }
            }
        }
    }
}

document.addEventListener('DOMContentLoaded', setupGalleryAndCaptions);
document.addEventListener('astro:page-load', setupGalleryAndCaptions);

// [중요] CSS가 lang-en 클래스를 보고 알아서 롤링 애니메이션을 돌리므로,
// MutationObserver로 요소를 강제 덮어씌울 필요가 없습니다. (지우거나 둠)
</script>