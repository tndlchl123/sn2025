---
import Layout from '@common/Brand-Guidelines-Layout.astro';
---

<Layout title="brand-guidelines">

  <!-- 첫 번째 페이지: 브랜드 전략 -->
  <section id="p1">
    <!-- 🖼️ SVG가 들어갈 자격 박스 (여기에 SVG를 복붙하세요) -->
    <div class="svg-wrapper">
      <!-- 예시: 아무 SVG나 여기에 그대로 붙여넣으면 알아서 박스에 쏙 들어갑니다 -->
      <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <g>
          <path d="M3.33,6.92l2.47,106.58-2.47,106.69h22.69l-2.47-106.59L26.02,6.92H3.33Z"/>
          <path d="M299.32,6.92l-72.98,187.82L188.66,6.92h-16.8l-97.28,189.89-2.14-189.89h-25.1l14.61,213.28h16.56L169.97,48.42l41.47,171.77h16.77L321.63,6.92h-22.31Z"/>
          <path d="M676.17,12.04c-55.55-33.84-118.44,10.61-141.39,47.69-45.32,73.21-19.09,162.02,51.66,167.12,59.9,4.32,96.26-44.5,105.56-59.46,17.03-27.4,23.32-57.6,21.99-85.18-1.4-29.01-13.97-55.65-37.81-70.17ZM665.95,180.05c-13.37,16.88-32.7,31.92-59.48,31.92-57.99,0-71.54-60.83-69.5-98.1,3.25-59.59,40.6-100.98,87.51-98.61,72.06,3.65,82.44,113.06,41.47,164.79Z"/>
          <path d="M464.05,12.04c-55.55-33.84-118.44,10.61-141.39,47.69-45.32,73.21-19.09,162.02,51.66,167.12,59.9,4.32,96.26-44.5,105.56-59.46,17.03-27.4,23.32-57.6,21.99-85.18-1.4-29.01-13.97-55.65-37.81-70.17ZM453.83,180.05c-13.37,16.88-32.7,31.92-59.48,31.92-57.99,0-71.54-60.83-69.5-98.1,3.25-59.59,40.6-100.98,87.51-98.61,72.06,3.65,82.44,113.06,41.47,164.79Z"/>
        </g>        
      </svg>
    </div>

    <h1>Brand guidelines</h1>
  </section>

  <!-- 두 번째 페이지: 로고 가이드 -->
  <section>
      <h2>02. Logo Guidelines</h2>
      <p>두 번째 페이지 테스트 내용입니다.</p>
      
      <div>
          <div>Primary Logo</div>
          <div>Secondary Logo</div>
      </div>
  </section>

  <!-- 세 번째 페이지: 컬러 시스템 -->
  <section>
      <h2>03. Color System</h2>
      <p>세 번째 페이지 테스트 내용입니다.</p>
  </section>
</Layout>

<style>
@font-face {
  font-family: 'IWOO';
  src: url('https://cdn.jsdelivr.net/gh/tndlchl123/iwoo@main/IWOO.woff2?v=1') format('woff2');
  font-display: swap;
}

@font-face {
    font-family: 'HakgyoansimBareondotumR';
    src: url('https://cdn.jsdelivr.net/gh/tndlchl123/iwoo@main/HakgyoansimBareondotumR.woff2') format('woff2');
    font-weight: normal;
    font-style: normal;
}

body, h1, h2, h3, h4, h5, h6, section, button, input, textarea, select {
  font-family: 'Asta Sans', 'IWOO', sans-serif;
  font-synthesis: none;
}
</style>

<!-- text style -->
<style>
  h1 { 
    font-family: 'geist', sans-serif;
    font-size: 10vw;
    font-weight: 500;
    text-transform: uppercase;
  }
  h2 { font-size: 3vw;}
</style>

<!-- d -->
<style>
#p1 .svg-wrapper {
  /* width: 100%; 대신 원하는 값 입력 */
  width: 80%; 
  max-width: 600px; /* 화면이 커져도 600px 이상 안 커지게 제한 */

  /* 높이를 고정하고 싶다면 flex-grow: 1;을 지우고 height를 줍니다 */
  /* height: 300px; */ 
}

#p1 .svg-wrapper {
  margin: 0 auto; /* 가로 중앙에 딱 맞게 정렬 */
  /* margin-left: 0; (왼쪽 정렬) */
  /* margin-right: 0; (오른쪽 정렬) */

  margin-top: 5vh; /* 위쪽 여백 밀어내기 */
  margin-bottom: 40px; /* 아래쪽 타이틀(h1)과의 간격 넓히기 */
}

#p1 .svg-wrapper svg {
  width: 10%;
  height: 10%;
  object-fit: contain; 
}

</style>