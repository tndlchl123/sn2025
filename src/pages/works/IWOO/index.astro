<!-- gradient box -->
<style>
.svg-title-wrap {
  width: 100%;
  position: relative;
  z-index: 2;
}

.gradient-box {
  position: relative;
  width: 100%;
  height: 100vh;

  z-index: 10;
  overflow: visible;
  
  background: linear-gradient(
    to bottom, 
    #a7aaab 0%,

    transparent 90%
  );

  display: flex;
  justify-content: center;
  align-items: flex-start;

  padding-inline: 10px;
  padding-top: 10px;
  /* padding-bottom: 60px; */
}

.gradient-box::before {
  content: "";
  position: absolute;
  inset: 0;
  
  background: linear-gradient(
    to top,
    rgba(var(--iw-1r), 1) 0%,
    rgba(var(--iw-1r), 0) 100%
  );
  
  /* backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px); */

  z-index: 1;
}

#glcanvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.responsive-svg-logo {
  width: 100%; 
  height: auto;
  display: block;

  overflow: visible;
  mix-blend-mode: hard-light;

  /* svg */
  fill: rgba(var(--iw-5r), 0.7);
  transition: opacity 0.5s var(--iw-mo);
}

.responsive-svg-logo.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.svg-title-wrap,
.info-toggle-wrap {
  position: relative;
  z-index: 10;
}

.pc-logo { display: block; }
.mo-logo { display: none; }

@media (max-width: 768px) {
  .pc-logo { display: none; }
  .mo-logo { display: block; }
}
</style>

