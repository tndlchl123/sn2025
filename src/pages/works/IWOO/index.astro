<!-- typography font input -->
<script>
// font input
document.addEventListener("astro:page-load", () => {
  
  // ★ 여기서 영문과 한글의 최대 글자 수를 각각 따로 설정하세요.
  const MAX_LENGTH_EN = 50; // 영문 최대 글자 수
  const MAX_LENGTH_KO = 90;  // 한글 최대 글자 수
  
  // ==========================================
  // [1] 오른쪽 영역: 글자 입력 및 슬라이더 로직
  // ==========================================
  const wghtText = document.getElementById('wghtText');

  if (wghtText) {
    wghtText.style.setProperty('--wght', 200);
    wghtText.style.fontWeight = '200';
    wghtText.style.fontStyle = 'normal';
    wghtText.style.fontVariationSettings = "'wght' 200, 'ital' 0";

    // 1. 엔터 키 및 글자 수 초과 방지
    wghtText.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        return;
      }
      const allowedKeys = ['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'];
      if (allowedKeys.includes(e.key)) return;

      if (this.innerText.length >= MAX_LENGTH_EN) {
        e.preventDefault();
      }
    });

    // 2. 타이핑 시 한글 즉시 제거 및 영문 글자 수 강제 제한
    wghtText.addEventListener('input', function() {
      let originalText = this.innerText;
      let newText = originalText.replace(/[ㄱ-ㅎㅏ-ㅣ가-힣]/g, ''); // 한글 제거

      // 최대 글자 수를 넘어가면 자름
      if (newText.length > MAX_LENGTH_EN) {
        newText = newText.substring(0, MAX_LENGTH_EN);
      }

      // 텍스트에 변화가 생겼을 때만 업데이트하고 커서 복구
      if (originalText !== newText) {
        this.innerText = newText;
        const range = document.createRange();
        const sel = window.getSelection();
        range.selectNodeContents(this);
        range.collapse(false);
        sel.removeAllRanges();
        sel.addRange(range);
      }
    });

    // 3. 붙여넣기 시 한글 차단 및 글자 수 제한
    wghtText.addEventListener('paste', function(e) {
      e.preventDefault();
      let paste = (e.clipboardData || window.clipboardData).getData('text');
      paste = paste.replace(/\n/g, ' ');
      paste = paste.replace(/[ㄱ-ㅎㅏ-ㅣ가-힣]/g, '');

      const currentLength = this.innerText.length;

      if (currentLength + paste.length > MAX_LENGTH_EN) {
        paste = paste.substring(0, MAX_LENGTH_EN - currentLength);
      }
      document.execCommand('insertText', false, paste);
    });
  }

  const weightRange = document.getElementById('weightRange');
  const italicRange = document.getElementById('italicRange');
  const sizeRange = document.getElementById('sizeRange');
  const fontSizeDisplay = document.getElementById('fontSizeDisplay');
  
  // 슬라이더를 움직일 때 실행되는 함수
  function updateSliderFont() {
    if (!weightRange || !italicRange || !wghtText) return;
    
    const wghtValue = weightRange.value;
    const italValue = italicRange.value;
    
    // ★ 수정됨: px 직접 계산 대신 배율(scale)을 CSS 변수로 전달
    if (sizeRange) {
      const scale = sizeRange.value / 100;
      wghtText.style.setProperty('--font-scale', scale);
    }

    wghtText.style.fontVariationSettings = `'wght' ${wghtValue}, 'ital' ${italValue}`;
    wghtText.style.setProperty('--wght', wghtValue);
    wghtText.style.fontWeight = wghtValue;
    wghtText.style.fontStyle = italValue > 0 ? 'italic' : 'normal';

    // ★ 수정됨: CSS가 최종 계산한 실제 px 값을 가져와서 표시
    if (fontSizeDisplay && sizeRange) {
      const computedPx = parseFloat(window.getComputedStyle(wghtText).fontSize);
      const pt = Math.round(computedPx * 0.75);              
      fontSizeDisplay.innerText = `이우 ${pt}pt ${Math.round(computedPx)}px`; 
    }
  }

  // 새로고침 시 기본 상태로 초기화하는 함수
  function initTypography() {
    if (!wghtText) return;
    
    if (weightRange) weightRange.value = 100;
    if (italicRange) italicRange.value = 0;
    
    // ★ 수정됨: 브라우저 너비 계산 대신 30~200% 배율 기본값 설정
    if (sizeRange) {
      sizeRange.min = 30;
      sizeRange.max = 100;   
      sizeRange.value = 100; 
    }

    updateSliderFont();
  }

  // 사용자가 브라우저 창 크기를 늘리거나 줄일 때도 최대값을 실시간으로 갱신
  window.addEventListener('resize', () => {
    // ★ 수정됨: 리사이즈 시 CSS가 알아서 크기를 바꾸므로 화면의 px 텍스트 표기만 업데이트
    updateSliderFont(); 
    if (typeof updateKoreanSliderFont === 'function') {
      updateKoreanSliderFont();
    }
  });

  // 이벤트 연결 및 최초 1회 실행
  if (weightRange && italicRange && wghtText) {
    weightRange.addEventListener('input', updateSliderFont);
    italicRange.addEventListener('input', updateSliderFont);
    if (sizeRange) sizeRange.addEventListener('input', updateSliderFont);

    initTypography();
  }

  // ==========================================
  // [2] 왼쪽 영역: 한글 전용 입력 로직
  // ==========================================
  const koreanText = document.getElementById('koreanText');

  if (koreanText) {
    
    // 1. 엔터 키 및 글자 수 제한 방지
    koreanText.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        return;
      }
      const allowedKeys = ['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'];
      if (allowedKeys.includes(e.key)) return;

      if (this.innerText.length >= MAX_LENGTH_KO) {
        e.preventDefault();
      }
    });

    // 2. 타이핑할 때 영문자 즉시 삭제 및 한글 글자 수 강제 제한
    koreanText.addEventListener('input', function() {
      let originalText = this.innerText;
      let newText = originalText.replace(/[a-zA-Z]/g, ''); // 영문 제거
      
      // 최대 글자 수를 넘어가면 자름
      if (newText.length > MAX_LENGTH_KO) {
        newText = newText.substring(0, MAX_LENGTH_KO);
      }

      // 텍스트에 변화가 생겼을 때만 업데이트하고 커서 복구
      if (originalText !== newText) {
        this.innerText = newText;
        const range = document.createRange();
        const sel = window.getSelection();
        range.selectNodeContents(this);
        range.collapse(false);
        sel.removeAllRanges();
        sel.addRange(range);
      }
    });

    // 3. 복사/붙여넣기 할 때 영문자만 삭제 및 글자 수 제한
    koreanText.addEventListener('paste', function(e) {
      e.preventDefault();
      let paste = (e.clipboardData || window.clipboardData).getData('text');
      paste = paste.replace(/\n/g, ' '); 
      paste = paste.replace(/[a-zA-Z]/g, '');

      const currentLength = this.innerText.length;

      if (currentLength + paste.length > MAX_LENGTH_KO) {
        paste = paste.substring(0, MAX_LENGTH_KO - currentLength);
      }
      document.execCommand('insertText', false, paste);
    });
  }

  // ==========================================
  // [3] 왼쪽 영역: 한글 폰트 크기 슬라이더 로직
  // ==========================================
  const sizeRangeKorean = document.getElementById('sizeRangeKorean');
  const fontSizeDisplayKorean = document.getElementById('fontSizeDisplayKorean');

  function updateKoreanSliderFont() {
    if (!sizeRangeKorean || !koreanText) return;
    
    // ★ 수정됨: px 직접 계산 대신 배율(scale)을 CSS 변수로 전달
    if (sizeRangeKorean) {
      const scale = sizeRangeKorean.value / 100;
      koreanText.style.setProperty('--ko-font-scale', scale);
    }

    // ★ 수정됨: CSS가 최종 계산한 실제 px 값을 가져와서 표시
    if (fontSizeDisplayKorean) {
      const computedPx = parseFloat(window.getComputedStyle(koreanText).fontSize);
      const pt = Math.round(computedPx * 0.75);              
      fontSizeDisplayKorean.innerText = `학교안심바른돋움 ${pt}pt ${Math.round(computedPx)}px`; 
    }
  }

  function initKoreanTypography() {
    if (!koreanText) return;
    
    // ★ 수정됨: 브라우저 너비 계산 대신 30~200% 배율 기본값 설정
    if (sizeRangeKorean) {
      sizeRangeKorean.min = 30;
      sizeRangeKorean.max = 100;   
      sizeRangeKorean.value = 100; 
    }

    updateKoreanSliderFont();
  }

  // ★ 수정됨: 기존 하단에 있던 별도의 window resize 이벤트를 위쪽 영문 resize 이벤트 안에 병합하여 제거함.

  if (koreanText && sizeRangeKorean) {
    sizeRangeKorean.addEventListener('input', updateKoreanSliderFont);
    initKoreanTypography();
  }
  
});


</script>


<!-- rotate cube -->
<script>
function initRotateCubes() {
  const cubes = document.querySelectorAll('.cube');
  const faceClasses = ['front', 'right', 'back', 'left'];

  document.fonts.ready.then(() => {
    cubes.forEach((cube, index) => {
      // 💡 [핵심 1] 이미 큐브 면을 만들었다면(초기화 완료) 다시 실행하지 않고 종료! (구조 파괴 방지)
      if (cube.dataset.initialized === 'true') return;
      cube.dataset.initialized = 'true';

      const baseHTML = cube.innerHTML.trim();
      cube.innerHTML = '';

      // 4개의 면 생성
      faceClasses.forEach((faceClass) => {
        const faceDiv = document.createElement('div');
        faceDiv.className = `face ${faceClass}`;
        faceDiv.innerHTML = `<span>${baseHTML}</span>`;
        cube.appendChild(faceDiv);
      });

      const firstFace = cube.querySelector('.face');
      const measuredWidth = firstFace.offsetWidth;

      cube.querySelectorAll('.face').forEach((face) => {
        face.style.width = `${measuredWidth + 1}px`; 
      });

      cube.style.width = `${measuredWidth}px`;
      if (cube.parentElement.className.includes('scene')) {
        cube.parentElement.style.width = `${measuredWidth}px`;
      }

      const halfWidth = measuredWidth / 2;
      cube.style.setProperty('--tz', `${halfWidth}px`);

      const keyframes = [];
      
      for (let i = 0; i <= 4; i++) {
        keyframes.push({
          // 💡 [핵심 2] 오타 수정: i * 90 으로 곱하기 연산자 추가!
          transform: `rotateY(-${i * 90}deg)`,
          easing: i < 4 ? 'cubic-bezier(0.65, 0, 0.35, 1)' : undefined
        });
      }

      cube.animate(keyframes, {
        duration: 7000,         
        iterations: Infinity,   
        delay: index * 100      
      });
    });
  });

  // 역재생(Reverse) 클릭 이벤트 로직
  const rotateBox = document.querySelector('.rotate-box');
  
  // 클릭 이벤트도 여러 번 중복해서 달리지 않도록 방어
  if (rotateBox && rotateBox.dataset.initialized !== 'true') {
    rotateBox.dataset.initialized = 'true';
    
    rotateBox.addEventListener('click', () => {
      const allCubes = document.querySelectorAll('.cube');
      allCubes.forEach((cube) => {
        const animations = cube.getAnimations();
        animations.forEach((anim) => {
          if (anim.playbackRate === 1) {
            // 시간 속성을 안전하게 가져옵니다.
            const duration = anim.effect.getTiming().duration || 7000;
            anim.currentTime = (anim.currentTime || 0) + (duration * 1000);
            anim.playbackRate = -1;
          } else {
            anim.playbackRate = 1;
          }
        });
      });
    });
  }
}

// 💡 [핵심 3] Astro 환경에 맞춰 페이지 렌더링 시마다 깔끔하게 1번씩만 실행
document.addEventListener('astro:page-load', initRotateCubes);
</script>


<!-- scroll -->
<script>
// scroll
document.addEventListener("astro:page-load", function() {

  // ==========================================
  // 1. 가이드선(그리드) 동적 생성 (ResizeObserver)
  // ==========================================
  const guideGroup = document.querySelector('.guide-lines');
  const centerDashGroup = document.querySelector('.center-dash-group'); // ★ 추가한 그룹 선택
  const box = document.querySelector('.logo-box');
  const svg = document.querySelector('.iwoo-logo'); // 혹은 .iwoo-clearspace-svg 등 사용하는 svg 선택자

  if (box && svg) {
    const guideX = [3.33, 26.02, 47.5, 321.63, 300.83, 502.00, 512, 714.00];
    const guideY = [6.92, 0, 220, 227];

    new ResizeObserver(() => {
      const svgW = svg.getBoundingClientRect().width;
      if (!svgW) return; 

      const scale = svgW / 717.31;
      const w = box.getBoundingClientRect().width / scale;
      const h = box.getBoundingClientRect().height / scale;

      const sX = (717.31 - w) / 2;
      const sY = (230.45 - h) / 2;

      // 1. 기존 가이드선 생성 코드
      if (guideGroup) {
        let html = '';
        guideY.forEach(y => html += `<line x1="${sX}" y1="${y}" x2="${sX + w}" y2="${y}" class="horiz-line" style="stroke-dasharray:${w}; stroke-dashoffset:${w};" />`);
        guideX.forEach(x => html += `<line x1="${x}" y1="${sY}" x2="${x}" y2="${sY + h}" class="vert-line" style="stroke-dasharray:${h}; stroke-dashoffset:${h};" />`);
        guideGroup.innerHTML = html;
      }




    }).observe(box);
  }

  // ==========================================
  // 2. 통합 스크롤 이벤트 파트
  // ==========================================
  const gridLogoSvg = document.querySelector('.iwoo-logo');
  const gridLogoBox = document.querySelector('.logo-box');  
  const sizeLogoBox = document.querySelector('.logo-size'); 
  const clearspaceBox = document.querySelector('#clearspace-guides');

  function onUnifiedScroll() {
    const windowHeight = window.innerHeight;

    // --- [A] 가이드선 스크롤 로직 (.logo-box 기준) ---
    if (gridLogoBox && gridLogoSvg) {
      const rectA = gridLogoBox.getBoundingClientRect();
      if (rectA.top < windowHeight && rectA.bottom > 0) {
        const totalDistA = windowHeight + rectA.height;
        const currentScrollA = windowHeight - rectA.top;
        let progressA = Math.max(0, Math.min(1, currentScrollA / totalDistA)); 
        if (progressA > 0.3 && progressA < 0.8) {
          gridLogoSvg.classList.add('show-points');
        } else {
          gridLogoSvg.classList.remove('show-points');
        }
      }
    }

    // --- [B] 로고 사이즈 변환 스크롤 로직 (.logo-size 기준) ---
    if (sizeLogoBox) {
      const rectB = sizeLogoBox.getBoundingClientRect();
      if (rectB.top < windowHeight && rectB.bottom > 0) {
        const totalDistB = windowHeight + rectB.height;
        const currentScrollB = windowHeight - rectB.top;
        let progressB = Math.max(0, Math.min(1, currentScrollB / totalDistB)); 
        const curveB = Math.sin(progressB * Math.PI); 
        sizeLogoBox.style.setProperty('--scroll-curve', curveB);
      }
    }

    // --- [C] ★ 여백 규정 애니메이션 로직 (.clearspace-guides 기준) ---
    if (clearspaceBox) {
      const rectC = clearspaceBox.getBoundingClientRect();
      const clearspaceSvg = clearspaceBox.closest('.iwoo-clearspace-svg'); // SVG 부모 찾기

      if (rectC.top < windowHeight && rectC.bottom > 0) {
        const totalDistC = windowHeight + rectC.height;
        const currentScrollC = windowHeight - rectC.top;
        let progressC = Math.max(0, Math.min(1, currentScrollC / totalDistC)); 

        // 화면 중앙 부근(0.3 ~ 0.8)에 오면 그룹과 SVG 전체에 모두 클래스 추가!
        if (progressC > 0.3 && progressC < 0.8) {
          clearspaceBox.classList.add('show-cs');
          if (clearspaceSvg) clearspaceSvg.classList.add('show-cs');
        } else {
          clearspaceBox.classList.remove('show-cs');
          if (clearspaceSvg) clearspaceSvg.classList.remove('show-cs');
        }
      }
    }
  }
  // ==========================================
  // 3. 패스 마커 좌표 텍스트 자동 생성 파트
  // ==========================================
  function generatePathCoordinates() {
    const paths = document.querySelectorAll('.pure-paths path');
    const labelsGroup = document.getElementById('coord-labels');
    if (!labelsGroup) return;

    const commandRegex = /([a-zA-Z])([^a-zA-Z]*)/g;
    const numberRegex = /-?\d*\.?\d+(?:e[-+]?\d+)?/gi;
    const drawnCoords = [];

    paths.forEach(path => {
      const d = path.getAttribute('d');
      if (!d) return;
      
      let match;
      let currentX = 0, currentY = 0;
      
      // 마커 주변 텍스트 겹침 방지 (더 넓은 반경 적용)
      function createCoordText(x, y) {
        // 검사 반경을 가로 60px, 세로 20px로 대폭 늘려서 빽빽한 곳은 하나만 남기고 다 생략
        const isOverlap = drawnCoords.some(c => Math.abs(c.x - x) < 60 && Math.abs(c.y - y) < 20);
        
        if (isOverlap) return;

        drawnCoords.push({ x, y });

        const textNode = document.createElementNS("http://www.w3.org/2000/svg", "text");
        
        // 마커 반경에서 완전히 벗어나도록 대각선으로 확실히 띄움
        textNode.setAttribute("x", x + 12); 
        textNode.setAttribute("y", y - 10); 
        
        textNode.textContent = `${x.toFixed(1)}, ${y.toFixed(1)}`;
        labelsGroup.appendChild(textNode);
      }

      while ((match = commandRegex.exec(d)) !== null) {
        const command = match[1];
        const numMatch = match[2].match(numberRegex);
        const args = numMatch ? numMatch.map(parseFloat) : [];
        
        if (command === 'M' || command === 'L') {
          for(let i = 0; i < args.length; i += 2) {
            currentX = args[i]; currentY = args[i+1]; createCoordText(currentX, currentY);
          }
        } else if (command === 'm' || command === 'l') {
          for(let i = 0; i < args.length; i += 2) {
            currentX += args[i]; currentY += args[i+1]; createCoordText(currentX, currentY);
          }
        } else if (command === 'H') {
          for(let i = 0; i < args.length; i++) {
            currentX = args[i]; createCoordText(currentX, currentY);
          }
        } else if (command === 'h') {
          for(let i = 0; i < args.length; i++) {
            currentX += args[i]; createCoordText(currentX, currentY);
          }
        } else if (command === 'V') {
          for(let i = 0; i < args.length; i++) {
            currentY = args[i]; createCoordText(currentX, currentY);
          }
        } else if (command === 'v') {
          for(let i = 0; i < args.length; i++) {
            currentY += args[i]; createCoordText(currentX, currentY);
          }
        } else if (command === 'C') {
          for(let i = 0; i < args.length; i += 6) {
            currentX = args[i+4]; currentY = args[i+5]; createCoordText(currentX, currentY);
          }
        } else if (command === 'c') {
          for(let i = 0; i < args.length; i += 6) {
            currentX += args[i+4]; currentY += args[i+5]; createCoordText(currentX, currentY);
          }
        }
      }
    });
  }

  generatePathCoordinates();



  let isTicking = false;
  window.addEventListener('scroll', () => {
    if (!isTicking) {
      window.requestAnimationFrame(() => {
        onUnifiedScroll();
        isTicking = false;
      });
      isTicking = true;
    }
  });
  
  onUnifiedScroll();
});


</script>


