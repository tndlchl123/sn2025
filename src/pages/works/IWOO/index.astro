/* 오른쪽: 회전 큐브를 담는 컨테이너 */
.iw-missionvision .box-missionvision .rotate-box {
  flex: 1;
  min-width: 0;

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  /* gap: 10px;  큐브 줄 간격 */
  
  /* 3D 큐브가 삐져나오거나 잘리는 것을 방지 */
  position: relative;
  overflow: hidden; 
  clip-path: inset(0);

  /* 배경색 */
  background-color: var(--iw-0);

  /* 글자 크기 및 박스 높이 */
  --iw-text-size: 4vw;
}
/* 1. 박스 왼쪽 절반 (← 커서) */
.iw-missionvision .box-missionvision .rotate-box::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 50%;
  height: 100%;
  cursor: w-resize;
  z-index: 10; /* 내부 텍스트 큐브들보다 마우스 인식이 먼저 되도록 덮어줍니다 */
}

/* 2. 박스 오른쪽 절반 (→ 커서) */
.iw-missionvision .box-missionvision .rotate-box::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 50%;
  height: 100%;
  cursor: e-resize;
  z-index: 10;
}
