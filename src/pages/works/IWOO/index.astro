<script>
document.addEventListener("astro:page-load", () => {
const container = document.getElementById('gradient-module');
const canvas = document.getElementById('gradient-canvas');

const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
// 창 크기가 아니라 부모 div(.gradient-module)의 크기에 맞춰 렌더링되도록 수정
renderer.setSize(container.clientWidth, container.clientHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(50, container.clientWidth / container.clientHeight, 0.1, 1000);

const controls = new THREE.OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;
controls.dampingFactor = 0.05;

// 화면 회전만
// controls.enableZoom = false; // 마우스 휠(확대/축소) 끄기 -> 페이지 스크롤 정상 작동
// controls.enablePan = false;  // 우클릭 및 쉬프트+드래그(화면 이동) 끄기

const planeGeo = new THREE.PlaneGeometry(120, 120, 512, 512);
const sphereGeo = new THREE.SphereGeometry(1, 256, 256); 

// ==========================================
// 1. 유니폼 (변수) 세팅 (Mode 1 ~ 4)
// ==========================================
const uniforms1 = {
  u_flatHoleDepth: { value: 60.0 }, u_flatHoleWidth: { value: 20.0 }, 
  u_bgColor: { value: new THREE.Color('#eceef2') }, u_color1: { value: new THREE.Color('#726558') }, 
  u_color2: { value: new THREE.Color('#3e312a') }, u_color3: { value: new THREE.Color('#1e1411') }, 
  u_color4: { value: new THREE.Color('#0a141e') }, u_color5: { value: new THREE.Color('#1d2c3f') }, 
  u_color6: { value: new THREE.Color('#7b95aa') }, u_color7: { value: new THREE.Color('#dcdee2') }, u_color8: { value: new THREE.Color('#eceef2') }  
};

const uniforms2 = {
  u_topHoleDepth: { value: 100.0 }, u_topHoleWidth: { value: 4.0 },
  u_bgColor: { value: new THREE.Color('#fff') }, u_color1: { value: new THREE.Color('#eceef2') }, 
  u_color2: { value: new THREE.Color('#dcdee2') }, u_color3: { value: new THREE.Color('#7b95aa') }, 
  u_color4: { value: new THREE.Color('#1d2c3f') }, u_color5: { value: new THREE.Color('#0a141e') }, 
  u_color6: { value: new THREE.Color('#1e1411') }, u_color7: { value: new THREE.Color('#3e312a') }, u_color8: { value: new THREE.Color('#726558') }  
};

const uniforms3 = {
  u_crossDepth: { value: 100.0 }, u_crossWidth: { value: 10.0 }, 
  u_bgColor: { value: new THREE.Color('#000000') }, u_color1: { value: new THREE.Color('#eceef2') }, 
  u_color2: { value: new THREE.Color('#dcdee2') }, u_color3: { value: new THREE.Color('#7b95aa') }, 
  u_color4: { value: new THREE.Color('#1d2c3f') }, u_color5: { value: new THREE.Color('#0a141e') }, 
  u_color6: { value: new THREE.Color('#1e1411') }, u_color7: { value: new THREE.Color('#3e312a') }, u_color8: { value: new THREE.Color('#726558') }  
};

const uniforms4 = {
  u_foldAngle: { value: 1 }, u_spread: { value: 43.0 }, 
  u_bgColor: { value: new THREE.Color('#000000') }, u_color1: { value: new THREE.Color('#726558') }, 
  u_color2: { value: new THREE.Color('#3e312a') }, u_color3: { value: new THREE.Color('#1e1411') }, 
  u_color4: { value: new THREE.Color('#0a141e') }, u_color5: { value: new THREE.Color('#1d2c3f') }, 
  u_color6: { value: new THREE.Color('#7b95aa') }, u_color7: { value: new THREE.Color('#dcdee2') }, u_color8: { value: new THREE.Color('#eceef2') }  
};

// ==========================================
// 2. 셰이더 생성 함수들
// ==========================================
function createGradient1() {
  const material = new THREE.ShaderMaterial({
    uniforms: uniforms1, side: THREE.DoubleSide, wireframe: false,
    vertexShader: `
      uniform float u_flatHoleDepth; uniform float u_flatHoleWidth; varying float vDist; 
      void main() {
        vec3 pos = position; vDist = length(pos.xy);
        
        pos.z += -u_flatHoleDepth / (pow(vDist / u_flatHoleWidth, 2.0) + 1.0);

        gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
      }
    `,
    fragmentShader: `
      uniform vec3 u_bgColor; uniform vec3 u_color1; uniform vec3 u_color2; uniform vec3 u_color3; uniform vec3 u_color4; 
      uniform vec3 u_color5; uniform vec3 u_color6; uniform vec3 u_color7; uniform vec3 u_color8;
      uniform float u_flatHoleWidth; varying float vDist;
      void main() {
        float factor = clamp(vDist / (u_flatHoleWidth * 3.0), 0.0, 1.0);
        float f = pow(factor, 1.5); float t = clamp(f * 8.0, 0.0, 8.0);
        vec3 color = u_bgColor;
        color = mix(color, u_color1, clamp(t - 0.0, 0.0, 1.0));
        color = mix(color, u_color2, clamp(t - 1.0, 0.0, 1.0));
        color = mix(color, u_color3, clamp(t - 2.0, 0.0, 1.0));
        color = mix(color, u_color4, clamp(t - 3.0, 0.0, 1.0));
        color = mix(color, u_color5, clamp(t - 4.0, 0.0, 1.0));
        color = mix(color, u_color6, clamp(t - 5.0, 0.0, 1.0));
        color = mix(color, u_color7, clamp(t - 6.0, 0.0, 1.0));
        color = mix(color, u_color8, clamp(t - 7.0, 0.0, 1.0));
        gl_FragColor = vec4(color, 1.0);
      }
    `
  });
  const mesh = new THREE.Mesh(planeGeo, material);
  mesh.rotation.x = -Math.PI / 2;
  return mesh;
}

function createGradient2() {
  const material = new THREE.ShaderMaterial({
    uniforms: uniforms2, side: THREE.DoubleSide, wireframe: false,
    vertexShader: `
      uniform float u_topHoleDepth; 
      uniform float u_topHoleWidth; 
      varying float vFactor; 
      varying vec3 vViewPosition; 
      varying vec3 vNormal; // ★ 프래그먼트 셰이더로 넘겨줄 부드러운 법선(Normal) 벡터
      
      // 높이 계산식을 재사용 가능한 함수로 분리
      float calcHeight(vec2 p) {
        vec2 c1 = vec2(15.0, 10.0); vec2 c2 = vec2(-20.0, -15.0);
        vec2 c3 = vec2(20.0, -25.0); vec2 c4 = vec2(-15.0, 25.0); vec2 c5 = vec2(0.0, 0.0);
        float r = u_topHoleWidth * 1.5;
        
        float m = (r*r*4.0) / (pow(length(p - c1), 2.0) + 1.0)
                + (r*r*6.0) / (pow(length(p - c2), 2.0) + 1.0)
                + (r*r*3.0) / (pow(length(p - c3), 2.0) + 1.0)
                + (r*r*5.0) / (pow(length(p - c4), 2.0) + 1.0)
                + (r*r*2.0) / (pow(length(p - c5), 2.0) + 1.0);
                
        return smoothstep(0.8, 1.8, m) * u_topHoleDepth * 0.4;
      }

      void main() {
        vec3 pos = position;
        
        // 1. 현재 정점의 높이 계산
        float h = calcHeight(pos.xy);
        pos.z += h;
        vFactor = h / (u_topHoleDepth * 0.4); 
        
        // ★ 2. 렉 없이 표면을 극도로 부드럽게 만드는 미적분(Central Difference) 수학 적용
        float eps = 0.1; // 미세한 간격
        float hx = calcHeight(pos.xy + vec2(eps, 0.0));
        float hy = calcHeight(pos.xy + vec2(0.0, eps));
        
        vec3 tx = vec3(eps, 0.0, hx - h);
        vec3 ty = vec3(0.0, eps, hy - h);
        
        // 부드러운 곡면의 진짜 뱡향(Normal)을 계산하여 넘겨줌
        vec3 objectNormal = normalize(cross(tx, ty));
        vNormal = normalMatrix * objectNormal;
        
        vec4 mvPosition = modelViewMatrix * vec4(pos, 1.0);
        vViewPosition = -mvPosition.xyz;
        gl_Position = projectionMatrix * mvPosition;
      }
    `,
    fragmentShader: `
      uniform vec3 u_bgColor; uniform vec3 u_color1; uniform vec3 u_color2; uniform vec3 u_color3; uniform vec3 u_color4; 
      uniform vec3 u_color5; uniform vec3 u_color6; uniform vec3 u_color7; uniform vec3 u_color8;
      varying float vFactor; 
      varying vec3 vViewPosition;
      varying vec3 vNormal; // ★ 버텍스 셰이더에서 받아온 부드러운 면 데이터
      
      void main() {
        float f = pow(clamp(vFactor, 0.0, 1.0), 3.0);
        float t = clamp(f * 8.0, 0.0, 8.0);
        
        vec3 color = u_bgColor;
        color = mix(color, u_color1, clamp(t - 0.0, 0.0, 1.0));
        color = mix(color, u_color2, clamp(t - 1.0, 0.0, 1.0));
        color = mix(color, u_color3, clamp(t - 2.0, 0.0, 1.0));
        color = mix(color, u_color4, clamp(t - 3.0, 0.0, 1.0));
        color = mix(color, u_color5, clamp(t - 4.0, 0.0, 1.0));
        color = mix(color, u_color6, clamp(t - 5.0, 0.0, 1.0));
        color = mix(color, u_color7, clamp(t - 6.0, 0.0, 1.0));
        color = mix(color, u_color8, clamp(t - 7.0, 0.0, 1.0));
        
        // ★ dFdx, dFdy 삭제: 각지게 만드는 범인들을 제거하고 부드러운 노멀 벡터를 그대로 사용
        vec3 normal = normalize(vNormal); 
        if (!gl_FrontFacing) normal = -normal;
        
        vec3 lightDir = normalize(vec3(1.0, 1.0, 1.0));
        float diff = max(dot(normal, lightDir), 0.0);
        
        vec3 viewDir = normalize(vViewPosition);
        float fresnel = pow(1.0 - max(dot(normal, viewDir), 0.0), 2.5);
        
        vec3 finalColor = color * (diff * 0.45 + 0.55); 
        finalColor += fresnel * u_color8 * f * 0.7; 
        
        gl_FragColor = vec4(finalColor, 1.0);
      }
    `
  });
  
  const mesh = new THREE.Mesh(planeGeo, material);
  mesh.rotation.x = -Math.PI / 2;
  return mesh;
}

function createGradient3() {
  const material = new THREE.ShaderMaterial({
    uniforms: uniforms3, side: THREE.DoubleSide, wireframe: false,
    vertexShader: `
      uniform float u_crossDepth; uniform float u_crossWidth; varying float vFactor;
      void main() {
        vec3 pos = position;
        float wx = abs(pos.x) / u_crossWidth; float wy = abs(pos.y) / u_crossWidth;
        float fx = 1.0 / (pow(wx, 2.0) + 1.0); float fy = 1.0 / (pow(wy, 2.0) + 1.0);
        pos.z -= (fx + fy) * u_crossDepth; vFactor = clamp((fx + fy) * 0.5, 0.0, 1.0);
        gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
      }
    `,
    fragmentShader: `
      uniform vec3 u_bgColor; uniform vec3 u_color1; uniform vec3 u_color2; uniform vec3 u_color3; uniform vec3 u_color4; 
      uniform vec3 u_color5; uniform vec3 u_color6; uniform vec3 u_color7; uniform vec3 u_color8;
      varying float vFactor;
      void main() {
        float f = pow(vFactor, 1.2); float t = clamp(f * 8.0, 0.0, 8.0);
        vec3 color = u_bgColor;
        color = mix(color, u_color1, clamp(t - 0.0, 0.0, 1.0));
        color = mix(color, u_color2, clamp(t - 1.0, 0.0, 1.0));
        color = mix(color, u_color3, clamp(t - 2.0, 0.0, 1.0));
        color = mix(color, u_color4, clamp(t - 3.0, 0.0, 1.0));
        color = mix(color, u_color5, clamp(t - 4.0, 0.0, 1.0));
        color = mix(color, u_color6, clamp(t - 5.0, 0.0, 1.0));
        color = mix(color, u_color7, clamp(t - 6.0, 0.0, 1.0));
        color = mix(color, u_color8, clamp(t - 7.0, 0.0, 1.0));
        gl_FragColor = vec4(color, 1.0);
      }
    `
  });
  const mesh = new THREE.Mesh(planeGeo, material);
  mesh.rotation.x = -Math.PI / 2;
  return mesh;
}

function createGradient4() {
  const curveMaterial = new THREE.ShaderMaterial({
    uniforms: uniforms4, side: THREE.DoubleSide, wireframe: false,
    vertexShader: `
      uniform float u_foldAngle; uniform float u_spread; varying float vFactor;
      void main() {
        vec3 pos = position; 
        
        // ★ 형태(곡률)를 결정하는 부분에서는 u_spread 대신 고정 숫자(25.0)를 써서 구겨짐 방지
        float d = abs(pos.y) / 25.0; 
        
        // 곡면 세로 위치 위쪽으로
        pos.z += (pow(d, 2.0) * u_foldAngle * 20.0) + 0.1;

        // ★ 색상(빛 번짐)을 결정하는 인자(vFactor)에는 그대로 u_spread를 사용하여 슬라이더와 연동
        vFactor = 1.0 - clamp(abs(pos.y) / (u_spread * 2.0), 0.0, 1.0);
        
        gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
      }
    `,
    fragmentShader: `
      uniform vec3 u_bgColor; uniform vec3 u_color1; uniform vec3 u_color2; uniform vec3 u_color3; uniform vec3 u_color4; 
      uniform vec3 u_color5; uniform vec3 u_color6; uniform vec3 u_color7; uniform vec3 u_color8;
      varying float vFactor;
      void main() {
        float f = pow(vFactor, 1.2); 
        
        // ★ 색상 1부터 8까지 딱 떨어지게 매칭하기 위해 8.0이 아닌 7.0으로 곱합니다.
        float t = clamp(f * 7.0, 0.0, 7.0); 
        
        // ★ 핵심: 면의 맨 끝(빈 공간)을 무조건 '색상 1'로 꽉 채웁니다.
        vec3 color = u_color1; 
        
        // 이후 색상 2~8까지 순차적으로 섞여 들어갑니다.
        color = mix(color, u_color2, clamp(t - 0.0, 0.0, 1.0));
        color = mix(color, u_color3, clamp(t - 1.0, 0.0, 1.0));
        color = mix(color, u_color4, clamp(t - 2.0, 0.0, 1.0));
        color = mix(color, u_color5, clamp(t - 3.0, 0.0, 1.0));
        color = mix(color, u_color6, clamp(t - 4.0, 0.0, 1.0));
        color = mix(color, u_color7, clamp(t - 5.0, 0.0, 1.0));
        color = mix(color, u_color8, clamp(t - 6.0, 0.0, 1.0));
        
        gl_FragColor = vec4(color, 1.0);
      }
    `
  });
  const curveMesh = new THREE.Mesh(planeGeo, curveMaterial);
  curveMesh.rotation.x = -Math.PI / 2;

  const baseMaterial = new THREE.ShaderMaterial({
    uniforms: uniforms4, side: THREE.DoubleSide, wireframe: false,
    vertexShader: `
      uniform float u_spread; // ★ 1. 곡면과 번짐 비율을 맞추기 위해 u_spread 변수 추가
      varying float vFactor;
      void main() {
        vec3 pos = position; 
        
        // ★ 2. 곡면(curveMesh)과 100% 똑같은 그라디언트 번짐 공식을 적용합니다.
        vFactor = 1.0 - clamp(abs(pos.y) / (u_spread * 2.0), 0.0, 1.0);
        
        gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
      }
    `,
    fragmentShader: `
      uniform vec3 u_bgColor; uniform vec3 u_color1; uniform vec3 u_color2; uniform vec3 u_color3; uniform vec3 u_color4; 
      uniform vec3 u_color5; uniform vec3 u_color6; uniform vec3 u_color7; uniform vec3 u_color8;
      varying float vFactor;
      void main() {
        float f = pow(vFactor, 1.2); 
        float t = clamp(f * 7.0, 0.0, 7.0); 
        
        // ★ 바닥면의 빈 공간도 까만색이 아니라 '색상 1'로 꽉 채우기
        vec3 color = u_color1; 
        
        color = mix(color, u_color2, clamp(t - 0.0, 0.0, 1.0));
        color = mix(color, u_color3, clamp(t - 1.0, 0.0, 1.0));
        color = mix(color, u_color4, clamp(t - 2.0, 0.0, 1.0));
        color = mix(color, u_color5, clamp(t - 3.0, 0.0, 1.0));
        color = mix(color, u_color6, clamp(t - 4.0, 0.0, 1.0));
        color = mix(color, u_color7, clamp(t - 5.0, 0.0, 1.0));
        color = mix(color, u_color8, clamp(t - 6.0, 0.0, 1.0));
        
        gl_FragColor = vec4(color, 1.0);
      }
    `
  });
  const baseMesh = new THREE.Mesh(planeGeo, baseMaterial);
  // 기본 수평(-Math.PI / 2) 상태에서 앞뒤로 기울이기:
  baseMesh.rotation.x = -Math.PI / 2 + -0.15; // 숫자를 키우거나 음수로 바꿔가며 조절
  
  const group = new THREE.Group();
  group.add(curveMesh); 
  group.add(baseMesh);
  return group;
}



// ==========================================
// 3. 씬 세팅
// ==========================================
const gradient1 = createGradient1();
const gradient2 = createGradient2();
const gradient3 = createGradient3();
const gradient4 = createGradient4();

scene.add(gradient1);
scene.add(gradient2);
scene.add(gradient3);
scene.add(gradient4);

// 4개 모드의 기본 색상 데이터
const c1 = { bg: '#eceef2', c1: '#726558', c2: '#3e312a', c3: '#1e1411', c4: '#0a141e', c5: '#1d2c3f', c6: '#7b95aa', c7: '#dcdee2', c8: '#eceef2' };
const c2 = { bg: '#fff', c1: '#eceef2', c2: '#dcdee2', c3: '#7b95aa', c4: '#1d2c3f', c5: '#0a141e', c6: '#1e1411', c7: '#3e312a', c8: '#726558' };
const c3 = { bg: '#000000', c1: '#eceef2', c2: '#dcdee2', c3: '#7b95aa', c4: '#1d2c3f', c5: '#0a141e', c6: '#1e1411', c7: '#3e312a', c8: '#726558' };
const c4 = { bg: '#000000', c1: '#726558', c2: '#3e312a', c3: '#1e1411', c4: '#0a141e', c5: '#1d2c3f', c6: '#7b95aa', c7: '#dcdee2', c8: '#eceef2' };

// ★ 1. const를 let으로 변경 (값을 바꿀 수 있게)
let CURRENT_MODE = '1';

// ★ 2. 버튼 클릭 시 모드를 바꾸는 로직 추가 (let CURRENT_MODE = '1'; 바로 밑에 붙여넣기)
const modeBtns = document.querySelectorAll('.mode-btn');

modeBtns.forEach(btn => {
  btn.addEventListener('click', (e) => {
    // 기존 활성화 버튼 색상 빼기
    modeBtns.forEach(b => b.classList.remove('active'));
    // 클릭한 버튼 하얗게 만들기
    e.target.classList.add('active');

    // 모드 번호 업데이트 후 화면 재적용
    CURRENT_MODE = e.target.getAttribute('data-mode');
    applyModeSettings();
  });
});

// ==========================================
// 4. HTML UI 연동 로직
// ==========================================
// 3번째 슬라이더(elP3, cgP3) 관련 변수 완전히 삭제함
const elP1 = document.getElementById('val-p1');
const elP2 = document.getElementById('val-p2');

function bindColors(colorObj, targetUniforms) {
  const ids = ['bg', 'c1', 'c2', 'c3', 'c4', 'c5', 'c6', 'c7', 'c8'];
  ids.forEach(id => {
    const el = document.getElementById('val-' + id);
    if (!el) return;

    el.value = colorObj[id]; 
    el.style.backgroundColor = colorObj[id]; // 칩 색상 채우기
    
    // select 태그이므로 onchange 사용
    el.onchange = (e) => {
      e.target.style.backgroundColor = e.target.value; 

      if (id === 'bg') {
          scene.background = new THREE.Color(e.target.value);
          // 4번 모드처럼 u_bgColor가 있는 경우를 위해 추가
          if(targetUniforms.u_bgColor) targetUniforms.u_bgColor.value.set(e.target.value);
          colorObj.bg = e.target.value;
      } else {
          targetUniforms[`u_color${id.replace('c','')}`].value.set(e.target.value);
          colorObj[id] = e.target.value;
      }
    };
  });
}

function applyModeSettings() {
  gradient1.visible = (CURRENT_MODE === '1');
  gradient2.visible = (CURRENT_MODE === '2');
  gradient3.visible = (CURRENT_MODE === '3');
  gradient4.visible = (CURRENT_MODE === '4');

  if (CURRENT_MODE === '1') {
    // 1. 카메라 위치 및 바라보는 곳(Target) 설정
    camera.position.set(35.22, 16.75, -50.07);
    controls.target.set(-13.39, -48.45, 12.02); 
    
    scene.background = new THREE.Color(c1.bg); 
    
    // 2. 슬라이더 초기값을 맨 위 uniforms1에서 자동으로 가져옴 (이제 맨 위에서만 수정하면 됨!)
    elP1.min = 0; elP1.max = 100; 
    elP1.value = uniforms1.u_flatHoleDepth.value; 
    updateTooltip('val-p1', 'tip-p1'); 
    elP1.oninput = (e) => {
      uniforms1.u_flatHoleDepth.value = parseFloat(e.target.value);
      updateTooltip('val-p1', 'tip-p1'); 
    };

    elP2.min = 5; elP2.max = 50; 
    elP2.value = uniforms1.u_flatHoleWidth.value; 
    updateTooltip('val-p2', 'tip-p2'); 
    elP2.oninput = (e) => {
      uniforms1.u_flatHoleWidth.value = parseFloat(e.target.value);
      updateTooltip('val-p2', 'tip-p2'); 
    };
    
    bindColors(c1, uniforms1);
  } 
  else if (CURRENT_MODE === '2') {
    camera.position.set(38.75, 34.99, 8.19);
    controls.target.set(9.76, 24.49, 7.95); 

    scene.background = new THREE.Color(c2.bg); 
    
    // ★ 1번 슬라이더: 최대값을 120에서 100으로 변경
    elP1.min = 0; elP1.max = 100; 
    elP1.value = uniforms2.u_topHoleDepth.value;
    updateTooltip('val-p1', 'tip-p1'); 
    elP1.oninput = (e) => {
      uniforms2.u_topHoleDepth.value = parseFloat(e.target.value);
      updateTooltip('val-p1', 'tip-p1'); 
    };

    // ★ 2번 슬라이더: 최소/최대값을 0과 100으로 변경 (기존 2, 30)
    elP2.min = 0; elP2.max = 100; 
    elP2.value = uniforms2.u_topHoleWidth.value;
    updateTooltip('val-p2', 'tip-p2'); 
    elP2.oninput = (e) => {
      uniforms2.u_topHoleWidth.value = parseFloat(e.target.value);
      updateTooltip('val-p2', 'tip-p2'); 
    };

    bindColors(c2, uniforms2);
  }
  else if (CURRENT_MODE === '3') {
    camera.position.set(-20.48, -16.96, 29.05);
    controls.target.set(-19.87, -20.31, 28.10); // 3번 모드의 카메라 타겟

    scene.background = new THREE.Color(c3.bg); 
    
    elP1.min = 1; elP1.max = 100; 
    elP1.value = uniforms3.u_crossDepth.value;
    updateTooltip('val-p1', 'tip-p1'); 
    elP1.oninput = (e) => {
      uniforms3.u_crossDepth.value = parseFloat(e.target.value);
      updateTooltip('val-p1', 'tip-p1'); 
    };

    elP2.min = 5; elP2.max = 50; 
    elP2.value = uniforms3.u_crossWidth.value;
    updateTooltip('val-p2', 'tip-p2'); 
    elP2.oninput = (e) => {
      uniforms3.u_crossWidth.value = parseFloat(e.target.value);
      updateTooltip('val-p2', 'tip-p2'); 
    };

    bindColors(c3, uniforms3);
  } 
  else if (CURRENT_MODE === '4') {
    camera.position.set(-0.41, 33.21, 67);
    controls.target.set(-0.94, 4.47, -9.72); // 4번 모드의 카메라 타겟

    scene.background = new THREE.Color(c4.bg); 
    
    elP1.min = -0.5; elP1.max = 2.0; 
    elP1.value = uniforms4.u_foldAngle.value;
    updateTooltip('val-p1', 'tip-p1'); 
    elP1.oninput = (e) => {
      uniforms4.u_foldAngle.value = parseFloat(e.target.value);
      updateTooltip('val-p1', 'tip-p1'); 
    };

    elP2.min = 5; elP2.max = 50; 
    elP2.value = uniforms4.u_spread.value;
    updateTooltip('val-p2', 'tip-p2'); 
    elP2.oninput = (e) => {
      uniforms4.u_spread.value = parseFloat(e.target.value);
      updateTooltip('val-p2', 'tip-p2'); 
    };

    bindColors(c4, uniforms4);
  }
  
  controls.update();
}

applyModeSettings();

// 창 크기가 바뀔 때 부모 div 크기에 맞춰 캔버스 리사이징
window.addEventListener('resize', () => {
  camera.aspect = container.clientWidth / container.clientHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(container.clientWidth, container.clientHeight);
});

let isThreeVisible = true;
const threeObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    isThreeVisible = entry.isIntersecting;
  });
});
// 3D 캔버스를 감싸는 부모를 관찰
threeObserver.observe(container);

function animate() {
  requestAnimationFrame(animate); 
  
  // 화면에 보일 때만 렌더링 진행 (핵심 최적화)
  if (isThreeVisible) {
    controls.update(); 
    renderer.render(scene, camera);
  }
}
animate();



// 색상 박스 토글(위로 스르륵 펴지기) 로직
  const colorToggleBtn = document.getElementById('color-toggle');
  const colorPanel = document.getElementById('color-panel');

  colorToggleBtn.addEventListener('click', () => {
    colorPanel.classList.toggle('expanded');
    // 화살표 텍스트 토글
    colorToggleBtn.innerHTML = colorPanel.classList.contains('expanded') 
      ? '<span>color</span>' 
      : '<span>color</span>';
  });

// 슬라이더 툴팁 위치 및 퍼센트 계산 함수 (CSS 변수 자동 연동 버전)
function updateTooltip(inputId, tipId) {
  const input = document.getElementById(inputId);
  const tip = document.getElementById(tipId);
  if (!input || !tip) return;

  const min = parseFloat(input.min) || 0;
  const max = parseFloat(input.max) || 100;
  const val = parseFloat(input.value) || 0;
  
  const percent = (max === min) ? 0 : (val - min) / (max - min);
  
  // 툴팁 너비를 CSS 변수에서 가져옴
  const style = getComputedStyle(input.closest('.gradient-module'));
  const thumbW = parseInt(style.getPropertyValue('--thumb-width')) || 42;
  
  // ★ 핵심: 여백 계산 빼고, 딱 (100% - 툴팁너비) 안에서만 움직이게 묶어줌
  tip.style.left = `calc(${percent} * (100% - ${thumbW}px))`;
  tip.innerText = Math.round(percent * 100) + '%';
}




