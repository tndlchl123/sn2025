  position: relative; 
  overflow: hidden; 
}

.iwoo-logo {
  width: 100%; /* 반응형 동작을 위해 width 값을 줌 */
  max-width: 50vw;
  height: auto;
  -webkit-tap-highlight-color: transparent;

  /* ★ 필수: 선이 로고 밖(패딩 영역)으로 뻗어나갈 수 있게 허용 */
  overflow: visible; 
}

/* -------------------------------------------
   마커 사이즈 및 색상 중앙 제어부
   ------------------------------------------- */
.iwoo-logo .pure-paths {
  /* 로고 본체의 색상 */
  fill: rgba(var(--iw-0r), 0.8);

  /* 마커 네모의 크기를 결정하는 기준값 */
  --marker-size: 1.5; 
  stroke-width: var(--marker-size);

  stroke: transparent;

}

/* 마커 */
#anchor-square rect {
  fill: var(--iw-0); 
}

/* 마커: 기본 숨김 상태 */
.iwoo-logo .pure-paths path {
  marker: none;
  transition: fill 1.5s var(--iw-mo);
}

/* 로고: 클래스 .show-points */
.iwoo-logo.show-points .pure-paths path {
  marker: url(#anchor-square);
  fill: rgba(var(--iw-0r), 0.3);
}
/* -------------------------------------------
   가이드선 애니메이션 제어부
   ------------------------------------------- */
.guide-lines {
  pointer-events: none; /* 가이드선이 클릭을 방해하지 않도록 */
}

/* 가이드선 공통 디자인 */
.guide-lines line {
  stroke: var(--iw-0);
  stroke-width: 0.5;
  transition: stroke-dashoffset 1.5s var(--iw-mo); 
}

/* 클래스가 붙었을 때 애니메이션 실행 (!important 필수) */
.iwoo-logo.show-points .guide-lines line {
  stroke-dashoffset: 0 !important;
}





/* 좌표 텍스트 기본 디자인 및 위치 제어 */
#coord-labels text {
  font-size: 10px;              /* 글자 크기 조절 */
  fill: rgba(var(--iw-0r), 0.5);           /* 글자 색상 */
  font-family: 'Geist';
  font-weight: 400;
  
  /* ★ 위치 조절: 정중앙에서 x축, y축으로 얼만큼 밀어낼지 결정 */
  transform: translate(10px, -10px); 
  
  /* 애니메이션 준비 */
  opacity: 0;
  transition: opacity 1.5s var(--iw-mo);
}

/* 클래스 활성화 시 노출 */
.iwoo-logo.show-points #coord-labels text {
  opacity: 1;
}




.logo-size {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--iw-space);

  padding-block: var(--iw-space);
  --scroll-curve: 0;
}

/* p태그 */
.logo-size .mm p,
.logo-size .px p {
  position: absolute;
  top: var(--iw-space);     /* 위쪽 간격만 유지 */
  left: 50%;               /* 부모 박스의 가로 50% 지점으로 이동 */
  transform: translateX(-50%); /* 자기 너비의 절반만큼 왼쪽으로 당겨서 완벽한 중앙 배치 */
  
  font-family: 'Geist';
  font-size: 16px;
  font-weight: 200;
  line-height: 1.2;
  color: var(--iw-1);
  text-align: center;
  white-space: nowrap;
}

.logo-size .px,
.logo-size .mm {
  flex:1;
  background-color: var(--iw-0);
  aspect-ratio: 3 /4;
  padding: 0;

  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}
.logo-size svg {
  fill: var(--iw-1);
  transform-origin: center center; /* 정중앙을 기준으로 커짐 */
  will-change: transform;
  transition: transform 0.1s ease-out; /* 휠이 멈칫해도 0.1초 동안 부드럽게 이어줌 */
}

.logo-size .px svg,
.logo-size .mm svg {
  height: auto; 
  fill: var(--iw-1);
  transition: width 0.1s ease-out; 
}

/* ★ 인쇄용(mm): 화면 끝(0)에선 60%, 중앙(1)에선 15mm로 작아짐 */
.logo-size .mm svg {
  width: calc(100% - (100% - 15mm) * var(--scroll-curve));
}

/* ★ 디지털용(px): 화면 끝(0)에선 60%, 중앙(1)에선 30px로 작아짐 */
.logo-size .px svg {
  width: calc(100% - (100% - 50px) * var(--scroll-curve));
}




/* clear space ------------------------------------------------------------------------ */
.logo-clearspace {
  background-color: var(--iw-2);
  aspect-ratio: 16 / 9;
  width: 100%;

  margin-bottom: var(--iw-space);
  
  position: relative; 
  
  display: flex;
  justify-content: center;
  align-items: center;

  --fade-curve: 0;
  
  -webkit-tap-highlight-color: transparent;
}


.logo-clearspace .clearspace-title {
  position: absolute;
  top: var(--iw-space);
  
  display: flex;
  align-items: center;
  justify-content: center;  
  z-index: 1; 
  
  pointer-events: none; 

  font-family: 'Geist';
  font-size: 16px;
  font-weight: 400;
  
  /* color: var(--iw-4); */
  color: transparent;
}


/* ==========================================
   클리어 스페이스 (여백 규정) SVG 스타일
   ========================================== */
.logo-clearspace { overflow: hidden; }
.logo-clearspace .iwoo-clearspace-svg {
  width: 100%;
  height: auto;
  padding: 20vw;

  overflow: visible;
}

/* 1. 로고 본체 색상 제어 */
.iwoo-clearspace-svg .cs-logo-paths {
  fill: rgba(var(--iw-0r), 0.8);
  transition: fill 0.3s var(--iw-mo);
}

/* 2. 여백 가이드 그룹 전체 제어 (평소엔 투명하게 숨김) */
.cs-layer {
  pointer-events: none;
}


/* 4면 기본 여백 영역 (연한 투명도) */
.cs-layer .cs-area {
  fill: rgba(var(--iw-4r), 0.1); 
}

/* 비율 텍스트 (x, 0.3x) */
.cs-layer .cs-text {
  fill: rgba(var(--iw-4r), 0.5);
  font-size: 14px;
  font-family: 'geist';
  text-anchor: middle;
  dominant-baseline: central;
}

/* 3. 애니메이션 노출 (스크롤 등으로 클래스 추가 시 발동) */
.iwoo-clearspace-svg.show-clearspace .cs-layer {
  opacity: 1;
}

/* ==========================================
   클리어 스페이스 (여백 규정) 애니메이션 
   ========================================== */

/* SVG 내부 요소가 각자의 위치를 기준으로 커지도록 설정 */
.cs-layer .cs-area {
  transform-box: fill-box;
  transition: transform 1s var(--iw-mo);
}

/* 가로 박스: 왼쪽 끝을 축으로 가로(X) 길이를 0으로 대기 */
.cs-layer .cs-horiz {
  transform-origin: left;
  transform: scaleX(0);
}

/* 세로 박스: 위쪽 끝을 축으로 세로(Y) 길이를 0으로 대기 */
.cs-layer .cs-vert {
  transform-origin: top;
  transform: scaleY(0);
}

/* 텍스트 & 모서리 교차점: 투명도 0으로 대기 */
.cs-layer .cs-text {
  opacity: 0;
  transition: opacity 1s var(--iw-mo) 0.2s; 
}

/* 활성화 (.show-cs) */
