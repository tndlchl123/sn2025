<!-- 1. 십자가 블러 SVG 필터 (화면엔 안 보이고 숨겨둠) -->
<svg xmlns="http://www.w3.org/2000/svg" class="sr-only">
    <filter id="cross-blur" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
        <!-- 1. 가로(X)축으로 길게 번짐 -->
        <feGaussianBlur in="SourceGraphic" stdDeviation="100 0" result="blurX" />
        <!-- 2. 세로(Y)축으로 길게 번짐 -->
        <feGaussianBlur in="SourceGraphic" stdDeviation="0 100" result="blurY" />
        <!-- 3. 두 블러를 십자가 형태로 반반 합성 -->
        <feComposite in="blurX" in2="blurY" operator="arithmetic" k1="0" k2="0.5" k3="0.5" k4="0" result="cross" />
        <!-- 4. 십자가의 날카로운 경계를 일반 블러로 부드럽게 처리 -->
        <feGaussianBlur in="cross" stdDeviation="5" result="softCross" />
        <!-- 5. 블러 처리된 결과물에 채도 강조 -->
        <feColorMatrix in="softCross" type="saturate" values="2" />
    </filter>
</svg>

<!-- 2. 이미지 그리드 영역 -->
<div class="filter-test-grid">

    <div class="grid-item">
        <img src="/iwoo/1/1-1.webp" alt="이우 시그니처 사인 그래픽">
        <div class="blur-overlay"></div>
    </div>

    <div class="grid-item">
        <img src="/iwoo/etc/2.webp" alt="도자기 상단 곡면과 질감">
        <div class="blur-overlay"></div>
    </div>
    
    <div class="grid-item">
        <img src="/iwoo/etc/3.webp" alt="달항아리 상단">
        <div class="blur-overlay"></div>
    </div>
    
    <div class="grid-item">
        <img src="/iwoo/1/0-2.webp" alt="접시 연출 사진">
        <div class="blur-overlay"></div>
    </div>
    
    <div class="grid-item">
        <img src="/iwoo/1/5.webp?v=2" alt="정교한 유약의 결이 살아있는 도자기 접시">
        <div class="blur-overlay"></div>
    </div>
    
    <div class="grid-item">
        <img src="/iwoo/etc/4.webp" alt="빗겨간 붓 자국과 여백의 질감">
        <div class="blur-overlay"></div>
    </div>
</div>

<!-- 3. CSS 스타일링 -->
<style>
    /* 그리드 레이아웃 설정 */
    .filter-test-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(1080px, 1fr));
        gap: 20px;
        padding: 20px;
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
    }

    /* 개별 이미지 박스 (1080x1440 비율 고정) */
    .grid-item {
        position: relative;
        width: 100%;
        /* 1080 / 1440 비율을 유지하도록 설정 */
        aspect-ratio: 3 / 4; 
        overflow: hidden;
        background-color: #f5f5f5; /* 로딩 전 빈 공간 배경색 */
    }

    /* 실제 이미지 렌더링 */
    .grid-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* 💡 여기가 핵심: 이미지 위에 덮이는 필터 오버레이 */
    .blur-overlay {
        position: absolute;
        inset: 0; /* top, left, right, bottom 0 */
        z-index: 2;
        
        /* SVG 필터 적용 */
        backdrop-filter: url(#cross-blur);
        -webkit-backdrop-filter: url(#cross-blur); /* 사파리 호환성 */
        
        opacity: 1;
        transition: opacity 0.4s ease; /* 부드러운 전환 */
        pointer-events: none; /* 클릭 방해 금지 */
    }


</style>

<!-- 다운로드 기능 스크립트 -->
<script>
    document.querySelectorAll('.grid-item').forEach((item, index) => {
        // 클릭할 수 있다는 걸 알리기 위해 마우스 커서 변경
        item.style.cursor = 'pointer';

        item.addEventListener('click', () => {
            const img = item.querySelector('img');
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');

            // 추출할 이미지의 고정 해상도 (요청하신 3:4 비율)
            canvas.width = 1080;
            canvas.height = 1440;

            // 이미지를 캔버스로 불러오기 위한 임시 객체
            const tempImg = new Image();
            tempImg.crossOrigin = "anonymous"; // 외부 URL 에러(CORS) 방지
            
            tempImg.onload = () => {
                // 1. 캔버스에 십자가 SVG 필터 적용
                ctx.filter = 'url(#cross-blur)';

                // 2. 캔버스 전체에 이미지 그리기 (1080x1440 꽉 채우기)
                ctx.drawImage(tempImg, 0, 0, canvas.width, canvas.height);

                // 3. 합성된 캔버스를 이미지 데이터로 변환
                const dataURL = canvas.toDataURL('image/png');

                // 4. 가상의 링크를 만들어 강제 다운로드 실행
                const link = document.createElement('a');
                link.download = `iwoo_filtered_artwork_${index + 1}.png`; // 저장될 파일명
                link.href = dataURL;
                link.click();
            };
            
            // 이미지 소스 넣기 (이때 onload 실행됨)
            tempImg.src = img.src;
        });
    });
</script>