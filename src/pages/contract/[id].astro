---
const contractPassword = "1234";

import Layout from '@components/Layout.astro';
import ContractInfo from '@contract/ContractInfo.astro';
import ContractTxt from '@contract/ContractTxt.astro';

// 2. 고객사별 데이터 세팅 영역
export function getStaticPaths() {
  return [
    // ============================================================================
    // 고객: brand (접속 링크: sn2025.co.kr/contract/brand)
    // ============================================================================
    {
      params: { id: 'sn' }, // URL 주소 뒤에 붙을 난수나 이름
      props: {

        // [01] 계약 기본 정보
        basicInfo: {
            title: '디지털 컨텐츠 디자인 용역 계약',
            contractDate: '2025년 01월 01일',
            workStart: '2025년 01월 01일 부터',
            workEnd: '2025년 03월 01일 까지',
            modDays: '영업일 기준 7일',
            modStart: '2025년 02월 03일 부터',
            modEnd: '2025년 02월 10일 까지',
            modCount: '1회',
        },

        // [02] 수요자(고객) 정보
        clientInfo: {
            company: 'brand',
            ceo: '홍길동',
            bizNum: '123-45-67890',
            address: '서울특별시 12345',
            phone: '010-1234-5678',
            email: 'tndlchl123@naver.com',
        },

        // [03] 계약 금액 설정 (공급가액과 비율만 적으면 부가세/총액/분할금이 자동 계산됩니다)
        priceInfo: {
            supplyPrice: 258320000, // 공급가액 (부가세 10% 제외 금액, 숫자만 입력)
            downPercent: 35,        // 선급금 비율 (%)
            midPercent: 35,         // 중도금 비율 (% - 중도금이 없으면 0으로 입력)
            balancePercent: 30,     // 잔금 비율 (%)
        },

        // [04] 제공 범위 표 데이터
        scopeGroups: [
            {
                category: '디자인 기획',
                items: [
                    { quantity: 1, name: '시장 조사 보고서', spec: '1920 × 1080 (px)', format: 'PDF', dpi: 72, usage: '웹' },
                    { quantity: 1, name: '디자인 기획 보고서', spec: '1920 × 1080 (px)', format: 'PDF', dpi: 72, usage: '웹' },
                ],
            },
            {
                category: '디자인 제작',
                items: [
                    { quantity: 1, name: '로고 디자인 가로형', spec: '297 × 210 (mm)', format: 'AI', dpi: 300, usage: '인쇄' },
                    { quantity: 1, name: '로고 디자인 세로형', spec: '210 × 297 (mm)', format: 'AI', dpi: 300, usage: '인쇄' },
                    { quantity: 1, name: '로고 디자인 심볼형', spec: '297 × 297 (mm)', format: 'AI', dpi: 300, usage: '인쇄' },
                    { quantity: 3, name: '로고 디자인 목업', spec: '1920 × 1080 (px)', format: 'PNG', dpi: 72, usage: '웹' },
                    { quantity: 3, name: '로고 디자인 목업', spec: '1080 × 1920 (px)', format: 'PNG', dpi: 72, usage: '웹' },
                    { quantity: 1, name: '웹 배너 이미지', spec: '1920 × 1080 (px)', format: 'JPG', dpi: 72, usage: '웹' },
                ],
            },
            {
                category: '가이드 제작',
                items: [
                    { quantity: 1, name: '브랜드 가이드북', spec: '297 × 210 (mm)', format: 'PDF', dpi: 300, usage: '인쇄' },
                ],
            },
        ]
      }
    }
  ];
}

// 3. 위에서 매칭된 고객 데이터를 변수로 꺼내기
const { basicInfo, clientInfo, priceInfo, scopeGroups } = Astro.props;
---

<Layout title="contract">
<!-- 비밀번호 잠금 화면 -->
<div id="pw-overlay" class="pw-overlay">
    <input type="password" id="pw-input" placeholder="Enter password" autofocus />
</div>

<div id="pdf-content" class="contract-pdf-container">

    <!-- 계약 내용 (제1조 ~ 제21조) -->
    <ContractTxt />

    <!-- 계약 기본 정보 ([01] ~ [04]) -->
    <ContractInfo 
    basicInfo={basicInfo} 
    clientInfo={clientInfo} 
    priceInfo={priceInfo} 
    scopeGroups={scopeGroups} 
    />

    <!-- 동의/완료 -->
    <div class="contract-final-submit">
        <form id="contactForm" class="custom-form" novalidate>
            
            <!-- 1. 계약 내용 전체 동의 체크박스 -->
            <div class="form-group contact-group">
                <label class="contact-label" for="agreeAll">
                    <input type="checkbox" id="agreeAll" name="agreeAll" required />
                    <span class="custom-checkbox"></span>
                    <span class="contact-text translate" data-ko="위 계약 내용(제1조~제21조)을 모두 숙지하였으며, 이에 전체 동의합니다." data-en="I have read and fully agree to all terms and conditions above.">
                        위 계약 내용을 모두 숙지하였으며, 이에 전체 동의합니다.
                    </span>
                </label>
                <span class="error-msg" id="agreeAllError"></span>
            </div>

            <!-- 2. IP 및 시간 수집 안내 문구 -->
            <div class="agreement-notice">
                <span class="translate" data-ko="본 계약의 동의 및 기록 증명을 위하여, 아래의 동의 버튼을 통해 동의 시각과 접속 IP 주소가 수집되며 계약 문서와 함께 양측에 이메일로 발송됩니다." data-en="To verify consent and maintain records for this agreement, your consent timestamp and IP address will be collected via the consent button below and emailed to both parties along with the contract document.">
                    본 계약의 동의 및 기록 증명을 위하여, 아래의 동의 버튼을 통해 동의 시각과 접속 IP 주소가 수집되며 계약 문서와 함께 양측에 이메일로 발송됩니다.
                </span>
            </div>

            <!-- 3. 개인정보처리방침 동의 체크박스 (링크 포함) -->
            <div class="form-group contact-group">
                <label class="contact-label" for="privacyAgree">
                    <input type="checkbox" id="privacyAgree" name="privacyAgree" required />
                    <span class="custom-checkbox"></span>
                    <span class="contact-text">
                        <a href="/privacy" target="_blank" class="privacy-link translate" data-ko="개인정보처리방침" data-en="Privacy Policy">개인정보처리방침</a><span class="translate" data-ko="을 확인하였으며, IP 및 시간 정보 수집에 동의합니다." data-en=" has been read, and I agree to the collection of my IP and timestamp.">을 확인하였으며, IP 및 시간 정보 수집에 동의합니다.</span>
                    </span>
                </label>
                <span class="error-msg" id="privacyAgreeError"></span>
            </div>

            <!-- 3.5 결제 계좌 안내 및 입금자명 확인/Pdf 안내 -->
            <div class="form-group contact-group">
                
                <div class="bank-account-info">
                    <span class="bank-account-title">입금 계좌 안내</span><br>
                    
                    <!-- ⭐️ 계좌번호 복사 버튼 영역 -->
                    <button type="button" class="copy-account-btn" id="copyAccountBtn" aria-label="계좌번호 복사">
                        <span class="account-number" id="accountNumber">토스뱅크 1234-5678-9012</span>
                        
                        <!-- 복사 SVG 아이콘 -->
                        <svg class="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                        </svg>
                        
                        <!-- 복사 완료 시 나타날 텍스트 -->
                        <span class="copy-success-msg" id="copySuccessMsg">복사 완료</span>
                    </button>
                    <br><br>

                    <span class="bank-account-title">송금 완료 후 아래 버튼을 통해 계약서 PDF 저장</span>
                </div>

            </div>

            <!-- 4. 최종 제출 버튼 -->
            <button type="submit" id="finalSubmitBtn" class="translate" data-ko="계약 동의 및 전송" data-en="Agree and Submit">
                계약 동의 및 전송
            </button>
            <div id="finalSubmitResult" class="form-result"></div>
            
        </form>
    </div>

    <!-- 하단 플로팅 툴바 (아이콘 제거, PDF 텍스트 버튼 단독) -->
    <div class="print-toolbar">
        <button id="pdf-download-btn" class="pdf-btn" title="계약서 PDF 다운로드">
            계약서 저장
        </button>
    </div>

</div>

</Layout>

<!-- var -->
<style is:global>
.contract-container {
	--num-width: 50px; /* [01] */

    --p-width: 30px; /* 1. */
    --sp-width: 50px; /* (1) */
    --i-width: 50px; /* (a) */

    line-height: 1.5;

    font-family: var(--font-mono);
    
}
</style>

<!-- layout -->
<style is:global>
.contract-container {
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;

}

.contract-container {
    display: flex;
    width: 100%;
    gap: 50px;

    word-break: keep-all; 
    overflow-wrap: break-word; 
    z-index: 1;
}

/* index */
.contract-content-index {
    flex: 1;
    display: flex;
    align-items: flex-start;
    line-height: 1.2;
}

/* content */
.contract-content {
    flex: 2;
}
</style>

<!-- password -->
<style is:global>
.pw-overlay {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    
    background-color: rgba(var(--bg-color-r), 0.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
}

.pw-overlay input {
    background-color: rgba(var(--txt-color-r), 0.05);
    border: 1px solid rgba(var(--txt-color-r), 0.2);
    border-radius: 100px;
    color: var(--txt-color);
    text-align: center;
    padding: var(--pad);
    width: 30%;
    outline: none;
    font-family: var(--font-mono);
    transition: all 0.5s var(--motion, ease);
}

/* 마우스를 올렸을 때 살짝 진해짐 */
.pw-overlay input:hover {
    border-color: rgba(var(--txt-color-r), 0.5);
    background-color: rgba(var(--txt-color-r), 0.08);
}

/* 클릭해서 입력 중일 때 테두리가 꽉 차며 강조됨 */
.pw-overlay input:focus {
    border-color: var(--txt-color);
    background-color: rgba(var(--txt-color-r), 0.12);
}

.pw-overlay input::placeholder {
    color: var(--txt-color);
    opacity: 0.4;
    font-size: 1rem;
}

/* 스크롤 방지 */
body.is-locked { overflow: hidden; }

/* 인쇄 시 숨김 */
@media print {
    .pw-overlay { display: none !important; }
}
</style>

<!-- index -->
<style is:global>
ul.contract-index {
    list-style: none;
    margin: 0;
    padding: 0;

	z-index: 1;
}

/* each index */
ul.contract-index li {
    display: flex;

    color: var(--txt-color);

	opacity: 0.5;

	font-family: var(--font-mono), var(--font-asta), sans-serif;
    font-variation-settings: "wght" 400; 

    cursor: pointer;
    transition: all 1s var(--motion);
}
/* index gap */
ul.contract-index li:not(:last-child) {
  padding-bottom: 5px;
}
/* index num */
ul.contract-index li span {
    display: inline-block;
    width: var(--num-width); 
    font-variation-settings: "wght" 400;
    pointer-events: none;
    flex-shrink: 0;
}
</style>

<!-- index: active / hover -->
<style is:global>
ul.contract-index li.active, /* .active: 자바스크립트로 추가 */
ul.contract-index li.active span { 
	font-variation-settings: "wght" 550;
	opacity: 1; 
}

/* hover: pc only */
@media (hover: hover) and (pointer: fine) {
    ul.contract-index li:hover,
	ul.contract-index li:hover span {
        opacity: 1;
		font-variation-settings: "wght" 550;
	}
}
</style>

<!-- content -->
<style is:global>
.contract-content-section {
    display: flex;
    flex-direction: column;
    height: 0;
    opacity: 0;
    pointer-events: none;
    margin-bottom: 0;
    overflow: hidden;
    visibility: hidden;
    transition: all 1s var(--motion);
}

.contract-content-section.is-open {
    height: auto;
    opacity: 1;
    pointer-events: auto;
    /* gap */
    margin-bottom: var(--num-width);
    visibility: visible;
}

/* exept */
.contract-content-section.last-open {
    margin-bottom: 0;
}

/* content templete */

/* [01]: 조: article */
.contract-article {
    display: flex;
    align-items: flex-start;

	font-weight: 550;
    margin-bottom: 10px;
}
/* [01] */
.contract-article span:first-child {
    display: inline-block;
    flex-shrink: 0;

    font-weight: 500;

    width: var(--num-width); 
}

/* 1.: 항: paragraph */
.contract-paragraph {
    display: flex;
    align-items: flex-start;
        
    padding-left: var(--num-width);

    font-weight: 500;

    margin-bottom: 10px;
}
.contract-paragraph:last-of-type { margin-bottom: 0; }

.contract-paragraph span:first-child { 
    width: var(--p-width);
    flex-shrink: 0; 
}

/* (1): 호: subparagraph */
.contract-subparagraph {
    display: flex;
    align-items: flex-start;

    padding-left: calc(var(--num-width) + var(--p-width));

    font-weight: 450;

    margin-bottom: 10px;
}
.contract-subparagraph:last-of-type { margin-bottom: 0; }

.contract-subparagraph span:first-child { 
    width: var(--sp-width);
    flex-shrink: 0; 
}
.contract-subparagraph span { font-family: var(--font-mono), monospace; }
/* (a): 목: item */
.contract-item {
    display: flex;
    align-items: flex-start;

    padding-left: calc(var(--num-width) + var(--p-width) + var(--sp-width));

    margin-bottom: 10px; 
}
.contract-item:last-of-type { margin-bottom: 0; }

.contract-item span:first-child { 
    width: var(--i-width);
    flex-shrink: 0; 
}


</style>

<!-- mob -->
<style>
@media (max-width: 768px) {
    .contract-container {
        flex-direction: column; 
        gap: 0;
    }

    .contract-content-index {
        flex-direction: column;
        width: 100%;
        display: flex; 
        align-items: stretch;
    }

    .contract-content {
        flex: none;
        width: 100%;
    }

    ul.contract-index {
        width: 100%;
    }

    ul.contract-index li {
        width: 100%;
        box-sizing: border-box;
    }

    .contract-content-section {
        width: 100%;
        box-sizing: border-box;
    }

    .contract-content-section.is-open {
        padding-bottom: 0; 
        margin-top: 10px; 
    }

    .sn_contract-date_wrap {
        flex-direction: column;
        gap: 10px;
    }
}
</style>

<!-- 체크박스 -->
<style is:global>
/* 자동으로 생성되는 계약 동의 영역 스타일 */
.contract-agree-wrap {
    margin-top: 24px;
    display: flex;
}

.contract-paragraph .contract-agree-wrap { padding-left: var(--num-width); }

/* ⭐️ 공통 그룹 여백 */
.contract-agree-wrap .contact-group,
.contract-final-submit .contact-group {
    display: flex;
    flex-direction: column;
    width: 100%;
}

/* ----------------------------------------------------
   라벨 기본 스타일 (모션 및 테두리 대비)
------------------------------------------------------- */
.contract-agree-wrap .contact-label,
.contract-final-submit .contact-label,
#depositorName {
    display: flex;
    align-items: flex-start; 
    width: 100%;
    box-sizing: border-box;
    
    height: var(--input-h);
    padding: 10px;
    padding-left: 15px;
    
    background-color: rgba(var(--txt-color-r), 0.1);
    border-radius: var(--rad);
    
    /* ⭐️ 1. 에러 테두리 생성 시 덜컹거림 방지용 투명 테두리 */
    border: 1px solid transparent; 
    
    /* ⭐️ 2. 배경, 테두리, 글자색 변화에 부드러운 애니메이션 적용 */
    transition: background-color 1.5s var(--motion), border 0.5s var(--motion), color 0.5s var(--motion);
    
    cursor: pointer;
    font-family: var(--font-mono);
}

/* 자바스크립트 구조에 있던 빈 껍데기(custom-checkbox)는 완전히 숨김 */
.contract-agree-wrap .custom-checkbox,
.contract-final-submit .custom-checkbox {
    display: none;
}

/* ⭐️ 기본 체크박스 자체를 직접 스타일링 (각진 네모, 투명도 0.5) */
.contract-agree-wrap .contact-label input[type="checkbox"],
.contract-final-submit .contact-label input[type="checkbox"] {
    -webkit-appearance: none; 
    appearance: none;
    
    display: inline-block;
    width: 16px;
    height: 16px;
    
    /* 위쪽 정렬 시 텍스트 첫 줄과 높이를 자연스럽게 맞추기 위해 상단 마진 2px 추가 */
    margin: 2px 12px 0 0; 
    
    border: 1px solid var(--txt-color, #000);
    border-radius: 0; /* 완전한 직각 네모 */
    background-color: transparent; 
    opacity: 0.5;     
    
    position: relative;
    transition: all 0.5s var(--motion);
    flex-shrink: 0;
    cursor: pointer;
}

/* ⭐️ 체크(클릭)했을 때: 브라우저 기본 체크 아이콘 없이, 배경색만 꽉 차고 진해짐 */
.contract-agree-wrap .contact-label input[type="checkbox"]:checked,
.contract-final-submit .contact-label input[type="checkbox"]:checked {
    opacity: 1;
    background-color: var(--txt-color, #000); 
}

/* ⭐️ 텍스트 스타일: 투명도 제거 (항상 opacity 1) */
.contract-agree-wrap .contact-text,
.contract-final-submit .contact-text {
    color: var(--txt-color, #000);
    font-size: var(--form-fs);
    font-family: var(--font-mono);
    opacity: 1; /* 항상 진하게 고정 */
    line-height: 1.4; /* 체크박스와의 비율을 위해 살짝 줄간격 지정 */
}

/* ----------------------------------------------------
   에러 발생 시 처리 (is-invalid)
------------------------------------------------------- */
/* ⭐️ 3. 에러 발생 시: 배경색이 var(--bg-color)로 빠져 투명해지고 테두리가 나타남 */
.contract-agree-wrap .contact-group.is-invalid .contact-label,
.contract-final-submit .contact-group.is-invalid .contact-label {
    border: 1px solid var(--txt-color); /* 테두리 생성 */
    background-color: var(--bg-color); /* 배경색을 흰색(기본 바탕)으로 완전히 뺌 */
    color: var(--txt-color);
}

/* ----------------------------------------------------
   커스텀 에러 메시지 스타일
------------------------------------------------------- */
.contract-agree-wrap .error-msg,
.contract-final-submit .error-msg { 
    display: none; 
    font-size: var(--form-fs); 
    font-family: var(--font-mono);
    /* ⭐️ 4. 보내주신 예전 폼 코드처럼 여백 적용 */
    padding-block: var(--pad); 
    padding-left: var(--pad);
    color: var(--txt-color);
}

.contract-agree-wrap .error-msg.show,
.contract-final-submit .error-msg.show { 
    display: block; 
    animation: fadeIn 0.3s var(--motion);
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: translateY(0); }
}

/* ----------------------------------------------------
   최종 제출 폼 여백
------------------------------------------------------- */



/* 상단 조문 컨테이너(.contract-container)와 ContractInfo(.pay-notice-wrap) 사이 여백 */
.pay-notice-wrap {
    margin-top: 8vh;
    transition: margin-top 0.5s var(--motion);
}

/* 조문이 펼쳐졌을 때(.is-open) 아래 영역과의 여백을 더 넉넉하게 확보 */
.contract-container:has(.contract-content-section.is-open) + .pay-notice-wrap {
    margin-top: 12vh;
}

