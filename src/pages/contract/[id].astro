<!-- index -->
<script>
function initcontractAccordion() {
    const listItems = document.querySelectorAll('.contract-index li');
    const sections = document.querySelectorAll('.contract-content-section');
    
    if (listItems.length === 0 || sections.length === 0) return;

    function updateLastOpenSection() {
        sections.forEach(sec => sec.classList.remove('last-open'));
        const openSecs = Array.from(sections).filter(sec => sec.classList.contains('is-open'));
        if (openSecs.length > 0) {
            openSecs[openSecs.length - 1].classList.add('last-open');
        }
    }

    function toggleSection(sec, isExpanding) {
        if (!sec) return;
        if (isExpanding) {
            sec.classList.add('is-open');
            sec.setAttribute('aria-hidden', 'false');
            sec.style.height = "0px";
            sec.offsetHeight; 
            sec.style.height = sec.scrollHeight + "px";
            setTimeout(() => {
                if (sec.classList.contains('is-open')) sec.style.height = "auto";
            }, 350);
        } else {
            sec.style.height = sec.offsetHeight + "px";
            sec.offsetHeight; 
            sec.classList.remove('is-open');
            sec.setAttribute('aria-hidden', 'true');
            sec.style.height = "0px";
        }
    }

    listItems.forEach((item, index) => {
        const runToggle = () => {
            if (index === 0) {
                const isExpanding = !item.classList.contains('active');
                listItems.forEach(li => {
                    li.classList.toggle('active', isExpanding);
                    li.setAttribute('aria-expanded', isExpanding); 
                });
                sections.forEach(sec => toggleSection(sec, isExpanding));
                updateLastOpenSection(); 
                return;
            }

            const isExpanding = !item.classList.contains('active');
            item.classList.toggle('active', isExpanding);
            item.setAttribute('aria-expanded', isExpanding);
            toggleSection(sections[index - 1], isExpanding);

            const subItems = Array.from(listItems).slice(1);
            const allActive = subItems.every(li => li.classList.contains('active'));
            listItems[0].classList.toggle('active', allActive);
            listItems[0].setAttribute('aria-expanded', allActive);

            updateLastOpenSection();
        };

        item.addEventListener('click', runToggle);
        item.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                runToggle();
            }
        });
    });
}
document.addEventListener('astro:page-load', initcontractAccordion);
</script>

<!-- link -->
<script>
function initcontractHashLink() {
    const hash = window.location.hash;
    if (!hash) return;

    const listItems = document.querySelectorAll('.contract-index li');
    const sections = document.querySelectorAll('.contract-content-section');
    if (listItems.length === 0 || sections.length === 0) return;

    const targetIds = hash.split(/[\/#]+/).filter(Boolean);
    let firstTargetSection = null;

    targetIds.forEach(id => {
        const targetSection = document.getElementById(id);
        if (!targetSection) return;

        if (!firstTargetSection) firstTargetSection = targetSection;

        const targetIndex = Array.prototype.indexOf.call(sections, targetSection);
        if (targetIndex !== -1) {
            const targetListItem = listItems[targetIndex]; 
            if (targetListItem && !targetListItem.classList.contains('active')) {
                targetListItem.click(); 
            }
        }
    });

    if (firstTargetSection) {
        setTimeout(() => {
            firstTargetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 400); 
    }
}
document.addEventListener('astro:page-load', initcontractHashLink);
</script>

<!-- password -->
<script is:inline define:vars={{ contractPassword }}>
(function() {
    // 프런트매터에서 넘어온 값을 TARGET_PW에 할당
    const TARGET_PW = contractPassword;

    document.body.classList.add('is-locked');

    const initPasswordLock = () => {
        const pwInput = document.getElementById('pw-input');
        const pwOverlay = document.getElementById('pw-overlay');

        if (pwInput && pwOverlay) {
            setTimeout(() => pwInput.focus(), 50);

            pwInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    if (pwInput.value === TARGET_PW) {
                        pwOverlay.style.display = 'none';
                        document.body.classList.remove('is-locked');
                    } else {
                        pwInput.value = '';
                    }
                }
            });
        }
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPasswordLock);
    } else {
        initPasswordLock();
    }
    document.addEventListener('astro:page-load', initPasswordLock);
})();
</script>

<!-- 통합 스크립트: 스크롤툴바모션 / 도장영구보존 / 자동인쇄팝업 / 계좌복사 / 동의전송 -->
<script is:inline>
function initContractSystem() {
    const toolbar = document.querySelector('.print-toolbar');
    const btnDownload = document.getElementById('pdf-download-btn');
    const form = document.getElementById('contactForm'); 
    const submitBtn = document.getElementById('finalSubmitBtn');
    const resultDiv = document.getElementById('finalSubmitResult');
    const rootEl = document.getElementById('contract-info-root');

    const companyName = rootEl && rootEl.dataset.company ? rootEl.dataset.company.trim() : 'sn';
    const storageKey = `sn_contract_agreed_${companyName}`;

    // ------------------------------------------------------------------
    // 1. 하단 툴바 스크롤 방향 감지 모션 (아래로 내리면 숨김, 위로 올리면 표시)
    // ------------------------------------------------------------------
    let lastScrollY = window.scrollY;
    let isScrolling = false;

    window.addEventListener('scroll', () => {
        if (!toolbar) return;
        if (!isScrolling) {
            window.requestAnimationFrame(() => {
                const currentScrollY = window.scrollY;
                if (currentScrollY > lastScrollY && currentScrollY > 100) {
                    toolbar.classList.add('is-hidden');
                } else {
                    toolbar.classList.remove('is-hidden');
                }
                lastScrollY = currentScrollY;
                isScrolling = false;
            });
            isScrolling = true;
        }
    });

    // ------------------------------------------------------------------
    // 2. 시스템 인쇄(PDF 저장) 실행 공통 함수
    // ------------------------------------------------------------------
    const triggerPrintPdf = () => {
        // 닫혀있는 아코디언 조문이 있다면 모두 펼치기
        const contractSections = document.querySelectorAll('.contract-content-section');
        contractSections.forEach(sec => sec.classList.add('is-open'));

        // 고객사 상호명을 PDF 저장 기본 파일명으로 자동 세팅
        const originalTitle = document.title;
        document.title = `${companyName}_디지털_컨텐츠_디자인_용역계약서`;

        window.print();

        document.title = originalTitle;
    };

    // ------------------------------------------------------------------
    // 3. 계좌번호 복사 기능
    // ------------------------------------------------------------------
    const copyBtn = document.getElementById('copyAccountBtn');
    if (copyBtn) {
        copyBtn.onclick = async () => {
            const textToCopy = "123456789012"; 
            try {
                await navigator.clipboard.writeText(textToCopy);
                copyBtn.classList.add('is-copied');
                setTimeout(() => copyBtn.classList.remove('is-copied'), 2000);
            } catch (err) {
                alert('복사에 실패했습니다.');
            }
        };
    }

    // ------------------------------------------------------------------
    // 4. 조문별 개별 동의 체크박스 자동 주입
    // ------------------------------------------------------------------
    const sections = document.querySelectorAll('.contract-content-section');
    if (sections.length > 0) {
        sections.forEach((section, idx) => {
            const secId = section.id || `sec_${idx + 1}`;
            const checkboxId = `contractAgree_${secId}`;

            if (!section.querySelector('.contract-agree-wrap')) {
                const agreeDiv = document.createElement('div');
                agreeDiv.className = 'contract-agree-wrap';
                agreeDiv.style.cssText = `
                    margin-top: 15px;
                    padding-left: var(--num-width);
                    box-sizing: border-box;
                    width: 100%;
                `;
                agreeDiv.innerHTML = `
                    <div class="form-group contact-group" style="width: 100%;">
                    <label class="contact-label" for="${checkboxId}">
                        <input type="checkbox" id="${checkboxId}" name="${checkboxId}" class="auto-contract-checkbox" required aria-invalid="false" />
                        <span class="custom-checkbox"></span>
                        <span class="contact-text translate" data-ko="위 내용을 확인하였으며 이에 동의합니다." data-en="I have read and agree to the above terms.">
                        위 내용을 확인하였으며 이에 동의합니다.
                        </span>
                    </label>
                    <span class="error-msg" id="${checkboxId}Error" aria-hidden="true"></span>
                    </div>
                `;
                section.appendChild(agreeDiv);
            }
        });
    }

    if (!form) return;

    let isAlreadySubmitted = false;

    const updateElementLang = (el, koText, enText, isEnglish) => {
        if (!el) return;
        el.classList.add('translate');
        el.setAttribute('data-ko', koText);
        el.setAttribute('data-en', enText);
        el.textContent = isEnglish ? enText : koText;
        el.style.fontFamily = isEnglish ? 'var(--font-mono)' : '';
    };

    const agreeAllEl = document.getElementById('agreeAll');
    const privacyAgreeEl = document.getElementById('privacyAgree');
    const autoCheckboxes = document.querySelectorAll('.auto-contract-checkbox');

    // ------------------------------------------------------------------
    // 5. [핵심] 전자 계약 동의 완료 증명 도장 생성 & 완료 상태 고정 함수
    // ------------------------------------------------------------------
    const renderAgreementStamp = (submitTime) => {
        isAlreadySubmitted = true;
        const isEnglish = localStorage.getItem('isEnglish') === 'true';

        let stampEl = document.getElementById('contract-print-stamp');
        if (!stampEl) {
            stampEl = document.createElement('div');
            stampEl.id = 'contract-print-stamp';
            stampEl.style.cssText = `
                margin-top: 20px;
                padding: 15px;
                border: 1px solid var(--txt-color);
                background-color: var(--bg-color);
                border-radius: var(--rad);
                font-size: 1rem;
                line-height: 1.5;
                color: var(--txt-color);
                text-align: left;
            `;
            form.appendChild(stampEl);
        }
        stampEl.innerHTML = `
            <p style="margin: 0; color: var(--txt-color);"><strong>[전자 계약 동의 완료 증명]</strong></p>
            <p style="margin: 0; color: var(--txt-color);">동의 일시: ${submitTime}</p>
            <p style="margin: 0; color: var(--txt-color);">동의 내역: 본 계약 문서의 전체 조문 및 개인정보 수집·이용 동의 완료</p>
        `;

        // 모든 체크박스 체크 상태로 고정
        autoCheckboxes.forEach(cb => {
            cb.checked = true;
            cb.setAttribute('onclick', 'return false;');
        });
        if (agreeAllEl) {
            agreeAllEl.checked = true;
            agreeAllEl.setAttribute('onclick', 'return false;');
        }
        if (privacyAgreeEl) {
            privacyAgreeEl.checked = true;
            privacyAgreeEl.setAttribute('onclick', 'return false;');
        }

        // 완료 버튼을 '계약서 PDF 저장' 버튼으로 전환하여 언제든 재출력 가능하게 유지
        if (submitBtn) {
            updateElementLang(submitBtn, '계약서 PDF 저장', 'Save Contract PDF', isEnglish);
            submitBtn.disabled = false;
        }
    };

    // 페이지 접속 시 이전에 동의한 기록이 있으면 도장과 체크박스 즉시 복원
    const savedStampTime = localStorage.getItem(storageKey);
    if (savedStampTime) {
        renderAgreementStamp(savedStampTime);
    }

    // 하단 플로팅 [PDF] 버튼 클릭 연결
    if (btnDownload) {
        btnDownload.onclick = (e) => {
            e.preventDefault();
            triggerPrintPdf();
        };
    }

    // ------------------------------------------------------------------
    // 6. 폼 검증 및 제출 -> 이메일 발송 -> 도장 생성 -> 인쇄창 자동 팝업
    // ------------------------------------------------------------------
    const showError = (id, koMsg, enMsg) => {
        const input = document.getElementById(id);
        const errorSpan = document.getElementById(`${id}Error`); 
        const isEnglish = localStorage.getItem('isEnglish') === 'true';

        if (input) {
            input.classList.add('is-invalid');
            input.setAttribute('aria-invalid', 'true'); 
            const group = input.closest('.contact-group') || input.closest('.form-group');
            if (group) group.classList.add('is-invalid');
        }
        if (errorSpan) {
            errorSpan.classList.add('translate');
            errorSpan.setAttribute('data-ko', koMsg);
            errorSpan.setAttribute('data-en', enMsg);
            errorSpan.textContent = isEnglish ? enMsg : koMsg;
            errorSpan.style.fontFamily = isEnglish ? 'var(--font-mono)' : '';
            errorSpan.classList.add('show');
            errorSpan.setAttribute('aria-hidden', 'false');
        }
    };

    const clearSingleError = (input) => {
        if (!input) return;
        input.classList.remove('is-invalid');
        input.setAttribute('aria-invalid', 'false');
        const group = input.closest('.contact-group') || input.closest('.form-group');
        if (group) group.classList.remove('is-invalid');

        const errorSpan = document.getElementById(`${input.id}Error`);
        if (errorSpan) {
            errorSpan.classList.remove('show');
            errorSpan.setAttribute('aria-hidden', 'true');
        }
    };

    const clearErrors = () => {
        document.querySelectorAll('.is-invalid').forEach(el => {
            el.classList.remove('is-invalid');
            if (el.tagName === 'INPUT') el.setAttribute('aria-invalid', 'false');
        });
        document.querySelectorAll('.error-msg.show').forEach(el => {
            el.classList.remove('show');
            el.setAttribute('aria-hidden', 'true');
        });
    };

    if (agreeAllEl) {
        agreeAllEl.onchange = (e) => {
            const isChecked = e.target.checked;
            autoCheckboxes.forEach(cb => {
                cb.checked = isChecked;
                if (isChecked) clearSingleError(cb); 
            });
            if (isChecked) clearSingleError(agreeAllEl);
        };
    }

    const uncheckAgreeAll = () => {
        if (agreeAllEl && agreeAllEl.checked) agreeAllEl.checked = false;
    };

    autoCheckboxes.forEach(cb => {
        cb.onchange = (e) => {
            if (!e.target.checked) uncheckAgreeAll();
            else clearSingleError(e.target);
        };
    });

    if (privacyAgreeEl) {
        privacyAgreeEl.onchange = (e) => {
            if (!e.target.checked) uncheckAgreeAll();
            else clearSingleError(e.target);
        };
    }

    form.onsubmit = async (e) => {
        e.preventDefault();

        // 이미 제출 완료된 상태라면 바로 PDF 저장(인쇄) 창 실행
        if (isAlreadySubmitted) {
            triggerPrintPdf();
            return;
        }

        clearErrors(); 

        const isEnglish = localStorage.getItem('isEnglish') === 'true';
        let hasError = false;

        autoCheckboxes.forEach(checkbox => {
            if (!checkbox.checked) {
                showError(checkbox.id, '! 내용을 확인하고 동의해주세요.', 'Please review and agree to the terms.');
                hasError = true;
            }
        });

        if (agreeAllEl && !agreeAllEl.checked) {
            showError('agreeAll', '! 계약 내용 전체 동의에 체크해주세요.', 'Please check to agree to all terms.');
            hasError = true;
        }

        if (privacyAgreeEl && !privacyAgreeEl.checked) {
            showError('privacyAgree', '! 개인정보처리방침 및 정보 수집에 동의해주세요.', 'Please agree to the Privacy Policy and data collection.');
            hasError = true;
        }

        if (hasError) return;

        if (submitBtn) {
            updateElementLang(submitBtn, '동의 내역 전송 중...', 'Submitting Agreement...', isEnglish);
            submitBtn.disabled = true;
        }
        if (resultDiv) resultDiv.style.display = 'none';

        try {
            const submitTime = new Date().toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' });

            const payload = {
                type: 'contract_agreement',
                contractTitle: rootEl ? rootEl.dataset.title : '디지털 컨텐츠 디자인 용역 계약',
                contractDate: rootEl ? rootEl.dataset.contractDate : '',
                company: rootEl ? rootEl.dataset.company : '',
                ceo: rootEl ? rootEl.dataset.ceo : '',
                bizNum: rootEl ? rootEl.dataset.bizNum : '',
                address: rootEl ? rootEl.dataset.address : '',
                phone: rootEl ? rootEl.dataset.phone : '',
                clientEmail: rootEl ? rootEl.dataset.email : '',
                supplyPrice: rootEl ? rootEl.dataset.supplyPrice : '',
                timestamp: submitTime,
                agreedItems: '계약 내용 전체 조문 숙지 및 동의 완료'
            };

            const response = await fetch('https://falling-night-3940.tndlchl123.workers.dev', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            
            if (response.ok) {
                // 1) 브라우저에 동의 일시 백업 (새로고침해도 도장 유지)
                localStorage.setItem(storageKey, submitTime);

                // 2) 도장 렌더링 및 버튼 상태 전환
                renderAgreementStamp(submitTime);

                if (resultDiv) {
                    resultDiv.className = 'form-result success translate';
                    updateElementLang(
                        resultDiv,
                        '계약 동의 전송이 완료되었습니다. 인쇄 창에서 [PDF로 저장]을 선택해 계약서를 보관해 주세요.',
                        'Agreement submitted. Please select [Save as PDF] in the print dialog to save your contract.',
                        isEnglish
                    );
                    resultDiv.style.display = 'block';
                }

                // 3) 도장이 화면에 찍힌 직후 0.3초 뒤 자동으로 PDF 저장(인쇄) 창 오픈
                setTimeout(() => {
                    triggerPrintPdf();
                }, 300);

            } else {
                const errData = await response.json();
                alert("🚨 워커 에러 원인: " + errData.error);
                throw new Error('전송 실패');
            }
        } catch (err) {
            console.error(err);
            if (resultDiv) {
                resultDiv.className = 'form-result error translate';
                updateElementLang(resultDiv, '오류가 발생했습니다. 다시 시도해 주세요.', 'An error occurred. Please try again.', isEnglish);
                resultDiv.style.display = 'block';
            }
            if (submitBtn) {
                updateElementLang(submitBtn, '계약 동의 및 전송', 'Agree and Submit', isEnglish);
                submitBtn.disabled = false;
            }
        }
    };
}

document.addEventListener('astro:page-load', initContractSystem);
document.addEventListener('DOMContentLoaded', initContractSystem);
</script>