---
import Layout from '@common/Layout.astro';
import WorksModal from '@common/WorksModal.astro';
import WorksGrid from '@common/WorksGrid.astro';
---

<Layout>
<div id="global-loader">
    <span class="loading-text">0%</span>
</div>

<div class="hero-wrapper">
    <section class="typo">
        <div
            class="main-typo translate col-start-4 span-3"
            data-en="shape new, sn<br>sn looks at the world with a new perspectives of design, bringing forth new shapes grounded in true essence."
        >
            shape new, sn<br>sn은 디자인을 통해 세상을 새롭게 바라보고 본질을 바탕으로 새로운 형태를 제안합니다.
        </div>
    </section>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <section class="motion-gallery-section">
        <canvas id="webgl-canvas"></canvas>
        <div class="works-data" style="display: none;">
            <WorksGrid />
        </div>
    </section>
</div>

<WorksModal />
</Layout>

<style is:global>
    /* 스크롤바 숨기기 및 mix-blend-mode: difference 동작을 위한 배경색 명시 */
    html.lenis,
    html.lenis body.default-body,
    html body.default-body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }
    
    .site-footer {
        padding-inline: var(--pad);
    }

    .global-header .header-container {
        padding-inline: var(--pad);
        padding-top: var(--pad);
        padding-bottom: 0;
    }

    /* PC 히어로 영역: 텍스트와 갤러리 간격을 확보하고 사진을 살짝 아래로 배치 */
    .hero-wrapper {
        width: 100%;
        height: calc(100dvh - 8dvh - (var(--pad, 16px) * 2));
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: clamp(1.5rem, 4vh, 3.5rem);
        position: relative;
        box-sizing: border-box;
    }

    /* 모바일 히어로 및 푸터 영역 */
    @media (max-width: 768px) {
        .hero-wrapper {
            width: 100%;
            height: calc(100vh - 8vh - (var(--pad, 16px) * 2));
            height: calc((var(--vh, 1vh) * 100) - 8vh - (var(--pad, 16px) * 2));
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: clamp(1.25rem, 3.5vh, 2.5rem);
            position: relative;
            overflow: hidden;
            box-sizing: border-box;
        }

        .site-footer {
            min-height: 3vh;
            padding: var(--pad);
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            box-sizing: border-box;
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            z-index: 99;
        }
    }
</style>

<!-- 로딩 화면 -->
<style>
    /* 전체 화면을 덮는 글로벌 로딩 화면 (#global-loader) */
    #global-loader {
        position: fixed; /* 화면에 찰싹 붙어서 전체를 덮음 */
        top: 0; 
        left: 0; 
        width: 100vw; 
        height: 100dvh; /* 모바일 사파리 하단바까지 덮도록 dvh 사용 */
        background: var(--bg-color);
        z-index: 9999;

        display: flex;
        justify-content: flex-start;
        align-items: flex-end;

        padding: var(--pad);

        transition: opacity 1s var(--motion), visibility 1s var(--motion);
    }
    
    /* 로딩 끝나면 투명해지면서 클릭도 통과하게 만듦 */
    #global-loader.is-hidden {
        opacity: 0;
        visibility: hidden;
    }

    /* 💡 [글자 크기 및 폰트 관리] .loading-text 스타일 */
    .loading-text {
        font-family: var(--font-geist); /* 요구하신 Geist 폰트 적용 */
        font-size: 6rem;                 /* 폰트 크기 관리 (원하시는 크기로 변경 가능) */
    }
</style>

<!-- 그리드 컬럼 스타일 -->
<style>
    .typo {
        width: 100%;
        padding-inline: var(--pad);
        box-sizing: border-box;
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: var(--pad);
        position: relative;
        z-index: 5;
        mix-blend-mode: difference;
        color: #ffffff;
        pointer-events: none;
    }

    .typo > * {
        min-width: 0;
    }

    /* 시작선 위치 */
    .col-start-1 { grid-column-start: 1; }
    .col-start-2 { grid-column-start: 2; }
    .col-start-3 { grid-column-start: 3; }
    .col-start-4 { grid-column-start: 4; }
    .col-start-5 { grid-column-start: 5; }
    .col-start-6 { grid-column-start: 6; }

    /* 칸 수 */
    .span-1 { grid-column-end: span 1; }
    .span-2 { grid-column-end: span 2; }
    .span-3 { grid-column-end: span 3; }
    .span-4 { grid-column-end: span 4; }
    .span-5 { grid-column-end: span 5; }
    .span-6 { grid-column: 1 / 7; }
</style>

<!-- 타이포그래피 스타일 -->
<style>
    /* 기본: 한글 */
    .main-typo {
        font-family: var(--font-asta);
        font-size: 1.5rem;
        font-weight: 600;
        line-height: 1.2;
        word-break: keep-all;
    }

    /* 번역: 영어 */
    :global(html:has(.lang-toggle-btn.active)) .main-typo.translate {
        font-family: var(--font-geist);
        line-height: 1;
    }

    /* 모바일 타이포그래피 */
    @media (max-width: 768px) {
        .main-typo {
            font-size: 6vw;
            grid-column-start: 3;
            grid-column-end: span 4;
        }
    }
</style>

<!-- 갤러리 스타일 -->
<style>
    .motion-gallery-section {
        width: 100%;
        height: 50svh;
        margin-top: 1.5vh;
        position: relative;
        overflow: visible;
        touch-action: pan-y;
        background: transparent;
        z-index: 1;
        cursor: grab;
        user-select: none;
        -webkit-user-select: none;
    }

    #webgl-canvas {
        position: absolute;
        top: 52%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100%;
        height: 150%;
        display: block;
        pointer-events: none;
    }
</style>

<!-- 갤러리 -->
<script is:inline>
document.addEventListener('astro:page-load', initThreeJSGallery);
document.addEventListener('DOMContentLoaded', initThreeJSGallery);

function initThreeJSGallery() {
    const section = document.querySelector('.motion-gallery-section');
    const canvas = document.getElementById('webgl-canvas');
    const imgElements = Array.from(document.querySelectorAll('.works-data img')).slice(0, 6);
    if (!section || !canvas || imgElements.length === 0) return;

    if (canvas.dataset.init === 'true') return;
    canvas.dataset.init = 'true';

    const CONFIG = {
        pc: {
            heightVh: 0.50,       // [화면 높이 비율] 높일수록 갤러리 이미지 크기가 커짐 (0.50 = 화면 높이의 50%)
            planeBend: 1.0,       // [전체 휨 강도] 값을 높일수록 카드 전체가 원통형처럼 앞으로 훅 꺾이며 휘어짐
            planeBendTiming: 5.0, // [휨 감쇠 지수] 값을 높일수록 중앙은 평평하게 유지되다가 '가장자리 쪽에서만' 급격하게 꺾임
            uvBendTiming: 5.0,    // [텍스처 왜곡 타이밍] 이미지 자체(텍스처)가 휘어지는 곡률의 집중도를 조절함
            uvBendX: 0,         // [가로 텍스처 왜곡] 값을 높일수록 이미지가 가로로 오목하게 찌그러지며 왜곡됨
            uvBendY: 0,         // [세로 텍스처 왜곡] 값을 높일수록 이미지가 세로로 오목하게 찌그러지며 왜곡됨
            stretchX: 0,      // [가로 탄성] 값을 높일수록 스크롤/드래그할 때 이미지가 가로로 쫙쫙 늘어남
            stretchY: 0.09        // [세로 탄성] 값을 높일수록 스크롤/드래그할 때 이미지가 세로로 홀쭉하게 찌그러짐 (속도감 극대화)
        },
        mobile: {
            heightVh: 0.42,       // [모바일 높이 비율] 모바일 화면 높이 대비 이미지 크기 (높일수록 커짐)
            planeBend: 1.35,      // [모바일 전체 휨] 화면이 좁은 모바일에서 입체감을 더 주기 위한 휨 강도
            planeBendTiming: 8.0, // [모바일 휨 감쇠] 모바일 가장자리 휨 곡률 조절
            uvBendTiming: 5.0,    // [모바일 텍스처 휨] 텍스처 왜곡 타이밍
            uvBendX: 0,         // [모바일 가로 텍스처 왜곡]
            uvBendY: 0,         // [모바일 세로 텍스처 왜곡]
            stretchX: 0,       // [모바일 가로 탄성] 스크롤 시 늘어나는 정도
            stretchY: 0.09       // [모바일 세로 탄성] 스크롤 시 눌리는 정도
        }
    };

    function getCssPadInPx() {
        const probe = document.createElement('div');
        probe.style.cssText = 'position:fixed;top:0;left:0;visibility:hidden;pointer-events:none;width:var(--rad, 16px);';
        document.body.appendChild(probe);
        let px = probe.getBoundingClientRect().width;
        document.body.removeChild(probe);
        if (!px || px <= 0) {
            const footer = document.querySelector('.site-footer');
            if (footer) {
                px = parseFloat(window.getComputedStyle(footer).paddingLeft) || 16;
            } else {
                px = 16;
            }
        }
        return px;
    }

    const renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: 'high-performance'
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, 1, 10, 4000);
    camera.position.z = 600;

    const vertexShader = `
        varying vec2 vUv;
        varying vec3 vWorldPos;
        uniform float uPlaneBend;
        uniform float uPlaneBendTiming;
        uniform float uScreenWidth;
        
        void main() {
            vUv = uv;
            vec4 worldPos = modelMatrix * vec4(position, 1.0);
            
            float halfScreen = max(uScreenWidth * 0.5, 1.0);
            float screenX = abs(worldPos.x) / halfScreen;
            float edgeBend = pow(screenX, uPlaneBendTiming);
            
            worldPos.z += edgeBend * 250.0 * uPlaneBend;
            
            vWorldPos = worldPos.xyz;
            gl_Position = projectionMatrix * viewMatrix * worldPos;
        }
    `;

    const fragmentShader = `
        uniform sampler2D uTexture;
        uniform float uScreenWidth;
        uniform float uBendTiming;
        uniform float uBendX;
        uniform float uBendY;
        uniform vec2 uUvScale;
        uniform vec2 uPlaneSize;
        uniform float uBorderRadius;
        
        varying vec2 vUv;
        varying vec3 vWorldPos;
        
        void main() {
            vec2 baseUv = (vUv - 0.5) * uUvScale + 0.5;
            
            float halfScreen = max(uScreenWidth * 0.5, 1.0);
            float screenX = vWorldPos.x / halfScreen;
            float edgeDist = abs(screenX);
            float edgeBend = pow(edgeDist, uBendTiming);
            
            baseUv.x = mix(baseUv.x, 0.5, edgeBend * uBendX);
            
            float yOffset = baseUv.y - 0.5;
            baseUv.y -= yOffset * edgeBend * uBendY;
            
            baseUv = clamp(baseUv, 0.0, 1.0);
            vec4 texColor = texture2D(uTexture, baseUv);

            vec2 halfSize = uPlaneSize * 0.5;
            float r = clamp(uBorderRadius, 0.0, min(halfSize.x, halfSize.y));
            vec2 p = abs((vUv - 0.5) * uPlaneSize) - (halfSize - r);
            float dist = length(max(p, 0.0)) + min(max(p.x, p.y), 0.0) - r;
            float roundedMask = 1.0 - smoothstep(-1.0, 1.0, dist);

            gl_FragColor = vec4(texColor.rgb, texColor.a * roundedMask);
        }
    `;

    const sharedGeometry = new THREE.PlaneGeometry(1, 1, 20, 20);
    const textureLoader = new THREE.TextureLoader();
    const items = [];

    let totalWidth = 0;
    let scrollX = 0;
    let targetScrollX = 0;
    let currentStretch = 0;
    let hasUserInteracted = false;
    let cachedCanvasWidth = 0;
    let cachedCanvasHeight = 0;

    function syncCanvasAndCamera() {
        const w = canvas.clientWidth || window.innerWidth;
        const h = canvas.clientHeight || (window.innerHeight * 0.75);
        if (w === 0 || h === 0) return false;

        if (w !== cachedCanvasWidth || h !== cachedCanvasHeight) {
            cachedCanvasWidth = w;
            cachedCanvasHeight = h;
            renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
            renderer.setSize(w, h, false);
            camera.aspect = w / h;
            camera.position.z = (h / 2) / Math.tan((camera.fov / 2) * Math.PI / 180);
            camera.updateProjectionMatrix();
            return true;
        }
        return false;
    }

    syncCanvasAndCamera();

    const initialPadPx = getCssPadInPx();

    imgElements.forEach((img, i) => {
        const linkEl = img.closest('a');
        const href = linkEl ? linkEl.getAttribute('href') : null;

        const texture = textureLoader.load(img.src, (tex) => {
            if (tex.image && tex.image.width > 0 && tex.image.height > 0) {
                items[i].aspect = tex.image.width / tex.image.height;
                updateResponsiveValues();
            }
        });
        texture.generateMipmaps = true;
        texture.minFilter = THREE.LinearMipmapLinearFilter;
        texture.magFilter = THREE.LinearFilter;

        const material = new THREE.ShaderMaterial({
            vertexShader,
            fragmentShader,
            uniforms: {
                uTexture: { value: texture },
                uScreenWidth: { value: cachedCanvasWidth || window.innerWidth },
                uPlaneBend: { value: 1.0 },
                uPlaneBendTiming: { value: 5.0 },
                uBendTiming: { value: 5.0 },
                uBendX: { value: 0.8 },
                uBendY: { value: 0.8 },
                uUvScale: { value: new THREE.Vector2(1.0, 1.0) },
                uPlaneSize: { value: new THREE.Vector2(300.0, 400.0) },
                uBorderRadius: { value: initialPadPx }
            },
            transparent: true,
            depthWrite: false,
            side: THREE.FrontSide
        });

        const mesh = new THREE.Mesh(sharedGeometry, material);
        mesh.frustumCulled = false;
        scene.add(mesh);

        items[i] = {
            mesh,
            linkEl,
            href,
            aspect: 3 / 4,
            baseWidth: 0,
            baseHeight: 0,
            baseX: 0
        };
    });

    function updateResponsiveValues() {
        const isMobile = window.innerWidth <= 768;
        const cfg = isMobile ? CONFIG.mobile : CONFIG.pc;

        const targetHeight = window.innerHeight * cfg.heightVh;
        const planeAspect = 3 / 4;
        const targetWidth = targetHeight * planeAspect;
        const borderRadiusPx = getCssPadInPx();
        const screenW = cachedCanvasWidth || window.innerWidth;

        items.forEach((item) => {
            if (!item || !item.mesh) return;

            item.baseWidth = targetWidth;
            item.baseHeight = targetHeight;
            item.mesh.scale.set(targetWidth, targetHeight, 1);

            let scaleX = 1.0;
            let scaleY = 1.0;
            if (item.aspect > planeAspect) {
                scaleX = planeAspect / item.aspect;
            } else {
                scaleY = item.aspect / planeAspect;
            }

            const uniforms = item.mesh.material.uniforms;
            uniforms.uUvScale.value.set(scaleX, scaleY);
            uniforms.uPlaneSize.value.set(targetWidth, targetHeight);
            uniforms.uBorderRadius.value = borderRadiusPx;
            uniforms.uPlaneBend.value = cfg.planeBend;
            uniforms.uPlaneBendTiming.value = cfg.planeBendTiming;
            uniforms.uBendTiming.value = cfg.uvBendTiming;
            uniforms.uBendX.value = cfg.uvBendX;
            uniforms.uBendY.value = cfg.uvBendY;
            uniforms.uScreenWidth.value = screenW;
        });

        recalculatePositions();
    }

    function recalculatePositions() {
        if (items.length === 0 || items[0].baseWidth === 0) return;

        const gap = window.innerWidth * 0.005;
        let x = 0;

        items.forEach((item) => {
            item.baseX = x;
            x += item.baseWidth + gap;
        });
        totalWidth = x;

        if (!hasUserInteracted) {
            targetScrollX = 0;
            scrollX = 0;
        } else {
            snapToNearest();
        }
    }

    updateResponsiveValues();

    window.addEventListener('resize', () => {
        syncCanvasAndCamera();
        updateResponsiveValues();
    });

    // 💡 현재 화면 정중앙에 위치한 아이템 찾기
    function getCenterItem() {
        if (items.length === 0 || totalWidth === 0) return null;
        let centerItem = null;
        let minDist = Infinity;

        items.forEach((item) => {
            const dist = Math.abs(item.mesh.position.x);
            if (dist < minDist) {
                minDist = dist;
                centerItem = item;
            }
        });

        // 중앙에서 반폭(0.45) 이내에 들어와 있을 때만 중앙 이미지로 인정
        if (centerItem && minDist < centerItem.baseWidth * 0.45) {
            return centerItem;
        }
        return null;
    }

    // 💡 클릭/터치한 화면 좌표(clientX, clientY)가 중앙 이미지 내부인지 판별
    function getHoveredCenterItem(clientX, clientY) {
        const centerItem = getCenterItem();
        if (!centerItem || !centerItem.mesh) return null;

        const rect = canvas.getBoundingClientRect();
        const canvasCenterX = rect.left + rect.width * 0.5;
        const canvasCenterY = rect.top + rect.height * 0.5;

        const localX = clientX - canvasCenterX;
        const localY = canvasCenterY - clientY;

        const halfW = (centerItem.mesh.scale.x || centerItem.baseWidth) * 0.5;
        const halfH = (centerItem.mesh.scale.y || centerItem.baseHeight) * 0.5;

        const isInside =
            Math.abs(localX - centerItem.mesh.position.x) <= halfW &&
            Math.abs(localY - centerItem.mesh.position.y) <= halfH;

        return isInside ? centerItem : null;
    }

    let isDragging = false;
    let wasDragged = false;
    const DRAG_THRESHOLD = 6; // 6px 이상 움직이면 드래그로 판정

    let startX = 0;
    let startY = 0;
    let lastPointerX = 0;
    let pointerVelocity = 0;
    let initialScrollX = 0;
    let snapTimeout;

    function snapToNearest() {
        if (totalWidth === 0) return;
        let minAbsDist = Infinity;
        let bestSnapX = targetScrollX;

        items.forEach((item) => {
            const x = item.baseX + targetScrollX;
            const wrappedX = ((x + totalWidth / 2) % totalWidth + totalWidth) % totalWidth - totalWidth / 2;

            if (Math.abs(wrappedX) < minAbsDist) {
                minAbsDist = Math.abs(wrappedX);
                bestSnapX = targetScrollX - wrappedX;
            }
        });
        targetScrollX = bestSnapX;
    }

    section.addEventListener('wheel', (e) => {
        e.preventDefault();
        hasUserInteracted = true;
        targetScrollX -= (e.deltaY * 0.8 + e.deltaX * 0.8);
        clearTimeout(snapTimeout);
        snapTimeout = setTimeout(snapToNearest, 90);
    }, { passive: false });

    // PC 마우스 이벤트
    section.addEventListener('mousedown', (e) => {
        isDragging = true;
        wasDragged = false;
        hasUserInteracted = true;
        startX = e.clientX;
        startY = e.clientY;
        lastPointerX = e.clientX;
        pointerVelocity = 0;
        initialScrollX = targetScrollX;
        clearTimeout(snapTimeout);
    });

    window.addEventListener('mousemove', (e) => {
        if (!isDragging) {
            // 드래그 중이 아닐 때: 중앙 이미지 위에 마우스가 있으면 pointer, 아니면 grab
            const hitItem = getHoveredCenterItem(e.clientX, e.clientY);
            section.style.cursor = (hitItem && hitItem.href) ? 'pointer' : 'grab';
            return;
        }

        const dist = Math.hypot(e.clientX - startX, e.clientY - startY);
        if (dist > DRAG_THRESHOLD) {
            wasDragged = true;
            section.style.cursor = 'grabbing';
        }

        if (wasDragged) {
            pointerVelocity = e.clientX - lastPointerX;
            lastPointerX = e.clientX;
            targetScrollX = initialScrollX + (e.clientX - startX) * 1.4;
        }
    });

    window.addEventListener('mouseup', (e) => {
        if (!isDragging) return;
        isDragging = false;

        if (wasDragged) {
            targetScrollX += pointerVelocity * 6.0;
            snapToNearest();
        }
        const hitItem = getHoveredCenterItem(e.clientX, e.clientY);
        section.style.cursor = (hitItem && hitItem.href) ? 'pointer' : 'grab';
    });

    // 모바일 터치 이벤트
    section.addEventListener('touchstart', (e) => {
        isDragging = true;
        wasDragged = false;
        hasUserInteracted = true;
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        lastPointerX = startX;
        pointerVelocity = 0;
        initialScrollX = targetScrollX;
        clearTimeout(snapTimeout);
    }, { passive: true });

    window.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        const currentX = e.touches[0].clientX;
        const currentY = e.touches[0].clientY;

        if (Math.hypot(currentX - startX, currentY - startY) > DRAG_THRESHOLD) {
            wasDragged = true;
        }

        if (wasDragged) {
            pointerVelocity = currentX - lastPointerX;
            lastPointerX = currentX;
            targetScrollX = initialScrollX + (currentX - startX) * 1.4;
        }
    }, { passive: true });

    window.addEventListener('touchend', () => {
        if (!isDragging) return;
        isDragging = false;

        if (wasDragged) {
            targetScrollX += pointerVelocity * 6.0;
            snapToNearest();
        }
    });

    section.addEventListener('click', (e) => {
        if (wasDragged) {
            e.preventDefault();
            return;
        }

        const hitItem = getHoveredCenterItem(e.clientX, e.clientY);
        if (hitItem && hitItem.linkEl) {
            e.preventDefault(); // 기본 페이지 이동을 무조건 막고 시작!

            // 만약 링크 태그에 open-modal 클래스가 붙어있다면 무조건 모달 함수 실행!
            if (hitItem.linkEl.classList.contains('open-modal') && typeof window.openWorksModal === 'function') {
                window.openWorksModal(hitItem.href);
            } else {
                // open-modal이 없을 때만 일반 페이지로 이동
                window.location.href = hitItem.href;
            }
        }
    });

    renderer.compile(scene, camera);
    renderer.render(scene, camera);

    function animate() {
        requestAnimationFrame(animate);

        const diff = targetScrollX - scrollX;
        scrollX += diff * 0.14;

        const isMobile = cachedCanvasWidth <= 768;
        const cfg = isMobile ? CONFIG.mobile : CONFIG.pc;
        const normSpeed = Math.min(Math.abs(diff) / (Math.max(cachedCanvasWidth, 320) * 0.18), 1.0);
        currentStretch += (normSpeed - currentStretch) * 0.15;

        const scaleFactorX = 1.0 + currentStretch * cfg.stretchX;
        const scaleFactorY = 1.0 - currentStretch * cfg.stretchY;

        if (totalWidth > 0) {
            items.forEach((item) => {
                if (!item || !item.mesh) return;
                let x = item.baseX + scrollX;
                x = ((x + totalWidth / 2) % totalWidth + totalWidth) % totalWidth - totalWidth / 2;
                item.mesh.position.x = x;

                const w = item.baseWidth * scaleFactorX;
                const h = item.baseHeight * scaleFactorY;
                item.mesh.scale.set(w, h, 1);
                item.mesh.material.uniforms.uPlaneSize.value.set(w, h);
            });
        }

        renderer.render(scene, camera);
    }

    animate();
}
</script>

<!-- 창 높이 계산 스크립트 -->
<script is:inline>
    function setScreenSize() {
        if (window.innerWidth <= 768) {
            const vh = window.innerHeight * 0.01;
            document.documentElement.style.setProperty('--vh', `${vh}px`);
        } else {
            document.documentElement.style.removeProperty('--vh');
        }
    }

    setScreenSize();
    window.addEventListener('resize', setScreenSize);
    document.addEventListener('astro:page-load', setScreenSize);
    document.addEventListener('DOMContentLoaded', setScreenSize);
</script>

<!-- 로딩 -->
<script is:inline>
if (typeof sessionStorage !== 'undefined' && sessionStorage.getItem('hasLoadedBefore') === 'true') {
    const _quickLoader = document.getElementById('global-loader');
    if (_quickLoader) {
        _quickLoader.style.display = 'none';
        _quickLoader.style.opacity = '0';
        _quickLoader.style.visibility = 'hidden';
    }
}

document.addEventListener('astro:page-load', () => {
    const loaderElement = document.getElementById('global-loader');
    const loaderText = document.querySelector('.loading-text');
    const imgElements = document.querySelectorAll('.works-data img');

    if (!loaderElement) return;

    if (loaderElement.dataset.initialized === 'true') return;
    loaderElement.dataset.initialized = 'true';

    /* 로딩 세션 확인 */
    if (sessionStorage.getItem('hasLoadedBefore') === 'true') {
        loaderElement.style.display = 'none';
        document.body.style.overflow = '';
        return;
    }  

    if (imgElements.length === 0) {
        loaderElement.classList.add('is-hidden');
        document.body.style.overflow = '';
        return;
    }

    document.body.style.overflow = 'hidden';
    loaderElement.style.opacity = '1';
    loaderElement.style.visibility = 'visible';
    loaderElement.style.display = 'flex';
    
    if (loaderText) {
        loaderText.style.opacity = '1';
        loaderText.style.color = 'var(--txt-color)';
    }

    let loadedCount = 0;
    let actualPercent = 0;
    let displayPercent = 0;
    let isFinished = false;

    function onImageLoad() {
        if (isFinished) return;
        loadedCount++;
        actualPercent = Math.floor((loadedCount / imgElements.length) * 100);
    }

    imgElements.forEach(img => {
        // 브라우저가 화면 밖에 있다고 로딩 안 하는 꼼수 원천 차단
        if (img.getAttribute('loading') === 'lazy') {
            img.setAttribute('loading', 'eager'); 
        }

        if (img.complete && img.naturalWidth !== 0) {
            onImageLoad(); 
        } else {
            img.addEventListener('load', onImageLoad);
            img.addEventListener('error', onImageLoad); 
        }
    });

    const forceFinishTimeout = setTimeout(() => {
        actualPercent = 100;
    }, 3000); 

    const progressTimer = setInterval(() => {
        if (displayPercent < actualPercent) {
            displayPercent += 2; 
            if (displayPercent > actualPercent) displayPercent = actualPercent;
        }

        if (loaderText) loaderText.textContent = displayPercent + '% ';

        if (displayPercent >= 100 && !isFinished) {
            isFinished = true;
            clearInterval(progressTimer);
            clearTimeout(forceFinishTimeout);
            sessionStorage.setItem('hasLoadedBefore', 'true');

            setTimeout(() => {
                // 🔥 1. 클래스 대신 인라인 스타일로 직접 투명도를 0으로 만들어야 우선순위가 맞음
                loaderElement.style.opacity = '0';
                loaderElement.style.visibility = 'hidden';
                
                document.body.style.overflow = ''; 

                // 🔥 2. CSS 트랜지션 시간(1s)에 맞춰서 display: none 타이머도 1000ms 이상으로 늦춤
                setTimeout(() => {
                    loaderElement.style.display = 'none';
                }, 1000); // 800 -> 1000으로 수정
            }, 200); 
        }
    }, 20);
});
</script>