---
import '@common/Global.css';
import { ClientRouter } from 'astro:transitions';
const { title = "sn2025" } = Astro.props;
---
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<ClientRouter />
		<link rel="icon" id="dynamic-favicon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<!-- <meta name="generator" content={Astro.generator} />  -->
		<meta name="color-scheme" content="light dark">
		<title>{title}</title>

		<link rel="preload" href="/fonts/GeistMono.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="preload" href="/fonts/AstaSans.woff2" as="font" type="font/woff2" crossorigin>

		<script is:inline src="/favicon.js"></script>
	</head>
	<body>
		<main>
			<!-- 각 페이지의 내용이 이 자리에 쏙 들어옵니다 -->
			<slot />
		</main>
		<script>import '@common/Global.js';</script>
    </body>
</html>

<style is:global>
:root {
    /* 배경 덮어쓰기 */
    --bg-color: #000;
    --txt-color: #000;
    --bg-color-r: #000;
    --txt-color-r: #000;

    --guide-txt: #111111; 
}

html body {
    background-color: var(--bg-color);
    color: var(--guide-txt);
    
    -webkit-user-select: auto;
    -moz-user-select: auto;
    -ms-user-select: auto;
    user-select: auto;

    display: flex;
    flex-direction: column;
    align-items: center;
}

/* text selection */
/* 텍스트 드래그(선택) 시 색상 반전 효과 */
::selection {background-color: var(--guide-txt); color: #fff;}
::-moz-selection {background-color: var(--guide-txt);color: #fff;}

/* 📱 2. 모바일 환경 (가로폭 767px 이하) */
@media (max-width: 767px) {
    section {
        aspect-ratio: 1 / 1.414; /* 웹: A4 세로형 비율 고정 */
    }
}

/* 💻 3. PC 환경 (가로폭 768px 이상) */
@media (min-width: 768px) {
    section {
        aspect-ratio: 1.414 / 1; /* 웹: A4 가로형 비율 고정 */
    }
}

/* 🌐 1. 웹 화면 및 공통 스타일 (미디어 쿼리 밖) */
section {
    width: 100%;
    padding: 15mm; 
    
    page-break-after: always; 
    break-after: page; 

    background-color: #fff;

    margin-bottom: 10vh;
}


/* 🖨️ 2. 인쇄(PDF) 전용 스타일 */
@media print {
    body {
        background-color: transparent; /* 인쇄할 땐 바디 검정 배경 날림 */
    }
    
    section {
        margin: 0; /* 인쇄 시 종이 사이 띄움 여백 완벽 제거 */
        overflow: hidden;
    }
}
</style>

<script>
  function updatePrintOrientation() {
    // 1. 동적으로 스타일 태그 생성
    let style = document.getElementById('dynamic-print-size');
    if (!style) {
      style = document.createElement('style');
      style.id = 'dynamic-print-size';
      document.head.appendChild(style);
    }
    
    // 2. 현재 찐 모니터 가로폭을 계산해서 인쇄 방향 강제 주입
    if (window.innerWidth >= 768) {
      style.innerHTML = '@page { size: A4 landscape; margin: 0; }';
    } else {
      style.innerHTML = '@page { size: A4 portrait; margin: 0; }';
    }
  }

  // 브라우저 창 크기를 조절할 때마다 업데이트
  window.addEventListener('resize', updatePrintOrientation);
  
  // Astro의 ClientRouter(페이지 이동) 환경에서도 스크립트가 실행되도록 설정
  document.addEventListener('astro:page-load', updatePrintOrientation);
</script>